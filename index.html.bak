// GIF 动画 base URL（GitHub raw 仓库）
const GIF_BASE = 'https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/';

// 从动作名（中文或英文）查找 GIF URL
function findExerciseGif(name) {
  if (!name) return '';
  const cleanName = name.trim();
  // 1. 先在 EXERCISES 中按 name_cn 精确匹配
  let ex = EXERCISES.find(e => e.name_cn === cleanName);
  // 2. 按 name_en 精确匹配（忽略大小写）
  if (!ex) ex = EXERCISES.find(e => e.name_en.toLowerCase() === cleanName.toLowerCase());
  // 3. 模糊匹配：AI 输出的动作名可能包含额外信息（如"杠铃卧推 - 3组×10次"），截取" - "之前的部分
  if (!ex) {
    const baseName = cleanName.split(/\s*[-–—]\s*/)[0].trim();
    if (baseName !== cleanName) {
      ex = EXERCISES.find(e => e.name_cn === baseName);
      if (!ex) ex = EXERCISES.find(e => e.name_en.toLowerCase() === baseName.toLowerCase());
    }
  }
  // 4. 更宽松的模糊匹配：动作名可能包含在 EXERCISES 的 name_cn 中
  if (!ex) {
    ex = EXERCISES.find(e => e.name_cn && e.name_cn.includes(cleanName));
  }
  if (!ex) {
    ex = EXERCISES.find(e => e.name_cn && cleanName.includes(e.name_cn));
  }
  // 5. 英文模糊匹配
  if (!ex) {
    const lower = cleanName.toLowerCase();
    ex = EXERCISES.find(e => e.name_en && e.name_en.toLowerCase().includes(lower));
  }
  if (ex && ex.gif_url) {
    return GIF_BASE + ex.gif_url;
  }
  return '';
}

// 查找动作的完整信息（用于弹窗显示）
function findExerciseInfo(name) {
  if (!name) return null;
  const cleanName = name.trim();
  let ex = EXERCISES.find(e => e.name_cn === cleanName);
  if (!ex) ex = EXERCISES.find(e => e.name_en.toLowerCase() === cleanName.toLowerCase());
  if (!ex) {
    const baseName = cleanName.split(/\s*[-–—]\s*/)[0].trim();
    if (baseName !== cleanName) {
      ex = EXERCISES.find(e => e.name_cn === baseName);
      if (!ex) ex = EXERCISES.find(e => e.name_en.toLowerCase() === baseName.toLowerCase());
    }
  }
  if (!ex) {
    ex = EXERCISES.find(e => e.name_cn && e.name_cn.includes(cleanName));
  }
  if (!ex) {
    ex = EXERCISES.find(e => e.name_cn && cleanName.includes(e.name_cn));
  }
  if (!ex) {
    const lower = cleanName.toLowerCase();
    ex = EXERCISES.find(e => e.name_en && e.name_en.toLowerCase().includes(lower));
  }
  return ex || null;
}

// 显示动作动画弹窗
function showExerciseGif(name) {
  const info = findExerciseInfo(name);
  const gifUrl = info && info.gif_url ? GIF_BASE + info.gif_url : '';
  const cnName = info ? info.name_cn : name;
  const enName = info ? info.name_en : '';
  const target = info ? info.target : '';
  const equip = info ? (EQUIP_CN[info.equipment] || info.equipment) : '';
  const group = info ? (GROUP_CN[info.group] || info.group) : '';
  const mechanics = info ? (info.mechanics_type === 'compound' ? '复合动作' : '孤立动作') : '';
  const secondary = info && info.secondary_muscles ? info.secondary_muscles.join('、') : '';

  // 移除已有弹窗
  const existing = document.getElementById('gif-modal');
  if (existing) existing.remove();

  const modal = document.createElement('div');
  modal.id = 'gif-modal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)';

  const card = document.createElement('div');
  card.style.cssText = 'background:var(--card);border-radius:16px;max-width:400px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.3)';

  let html = '<div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--border)">';
  html += `<div><div style="font-weight:700;font-size:16px;color:var(--text)">${cnName}</div>`;
  if (enName && enName !== cnName) html += `<div style="font-size:12px;color:var(--dim)">${enName}</div>`;
  html += '</div>';
  html += '<button onclick="this.closest(\'#gif-modal\').remove()" style="background:none;border:none;font-size:22px;color:var(--dim);cursor:pointer;padding:4px 8px">×</button>';
  html += '</div>';

  if (gifUrl) {
    html += `<div style="padding:16px;text-align:center;background:#fff;border-radius:8px">`;
    html += `<img src="${gifUrl}" alt="${cnName}" style="width:200px;height:200px;object-fit:contain;border-radius:8px;opacity:0;transition:opacity 0.3s" onload="this.style.opacity=1" onerror="this.style.display='none';document.getElementById('gif-fallback').style.display='block'"/>`;
    html += `<div id="gif-fallback" style="display:none;padding:40px 20px;color:var(--dim);font-size:13px">🎬 动画加载失败</div>`;
    html += '</div>';
  } else {
    html += `<div style="padding:40px 20px;text-align:center;color:var(--dim);font-size:13px">🎬 暂无动画资源</div>`;
  }

  // 动作详情
  const tags = [];
  if (group) tags.push(`<span style="background:var(--bg);padding:3px 8px;border-radius:4px;font-size:11px;color:var(--muted)">${group}</span>`);
  if (mechanics) tags.push(`<span style="background:var(--bg);padding:3px 8px;border-radius:4px;font-size:11px;color:var(--muted)">${mechanics}</span>`);
  if (equip) tags.push(`<span style="background:var(--bg);padding:3px 8px;border-radius:4px;font-size:11px;color:var(--muted)">${equip}</span>`);
  if (target) tags.push(`<span style="background:var(--bg);padding:3px 8px;border-radius:4px;font-size:11px;color:var(--muted)">目标：${target}</span>`);
  if (secondary) tags.push(`<span style="background:var(--bg);padding:3px 8px;border-radius:4px;font-size:11px;color:var(--muted)">辅助：${secondary}</span>`);

  if (tags.length > 0) {
    html += `<div style="padding:12px 16px;display:flex;flex-wrap:wrap;gap:6px;border-top:1px solid var(--border)">${tags.join('')}</div>`;
  }

  card.innerHTML = html;
  modal.appendChild(card);

  // 点击遮罩关闭
  modal.addEventListener('click', (e) => {
    if (e.target === modal) modal.remove();
  });

  document.body.appendChild(modal);
}

const GROUP_CN = {
  "chest":"胸","back":"背","shoulders":"肩","biceps":"二头","triceps":"三头",
