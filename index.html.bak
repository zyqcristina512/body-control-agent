<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>体重控制 Agent · Cris</title>
<style>
:root{--bg:#0f172a;--card:#1e293b;--border:#334155;--text:#e2e8f0;--muted:#94a3b8;--dim:#64748b;--accent:#38bdf8;--adim:rgba(56,189,248,.12);--green:#34d399;--gdim:rgba(52,211,153,.12);--yellow:#fbbf24;--ydim:rgba(251,191,36,.12);--red:#f87171;--redim:rgba(248,113,113,.12);--purple:#a78bfa;--pdim:rgba(167,139,250,.12)}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;min-height:100vh;font-size:14px}
.app{max-width:460px;margin:0 auto;padding-bottom:60px}
.hdr{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}.av{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#a78bfa);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700}.hdr-l{display:flex;align-items:center;gap:10px}.nm{font-weight:600;font-size:14px}.gl{font-size:11px;color:var(--green);background:var(--gdim);padding:2px 8px;border-radius:10px}.hdr-r{font-size:12px;color:var(--muted);cursor:pointer;padding:5px 10px;border:1px solid var(--border);border-radius:8px;background:0}
.tabs{display:flex;padding:10px 18px;gap:6px}.tab{flex:1;padding:9px;border:0;background:var(--card);color:var(--muted);border-radius:10px;font-size:13px;cursor:pointer}.tab.active{background:var(--adim);color:var(--accent)}
.page{display:none;padding:14px 18px}.page.active{display:block}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px}.ct{font-size:11px;color:var(--muted);margin-bottom:8px;font-weight:600;letter-spacing:.5px}
.callout{padding:11px 14px;border-radius:10px;margin-bottom:10px;font-size:13px;line-height:1.7}.callout.yellow{background:var(--ydim);border:1px solid rgba(251,191,36,.2)}.callout.green{background:var(--gdim);border:1px solid rgba(52,211,153,.2)}.callout.blue{background:var(--adim);border:1px solid rgba(56,189,248,.2)}.callout.purple{background:var(--pdim);border:1px solid rgba(167,139,250,.2)}.callout.red{background:var(--redim);border:1px solid rgba(248,113,113,.2)}.ct2{font-weight:600;margin-bottom:3px}
.stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}.stat{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:12px;text-align:center}.sl{font-size:10px;color:var(--dim);letter-spacing:.5px}.sv{font-size:18px;font-weight:700;margin-top:3px}.su{font-size:11px;color:var(--muted)}.sc{font-size:12px;margin-top:2px}.sc.dn{color:var(--green)}.sc.up{color:var(--red)}.sc.fl{color:var(--muted)}
.chart{height:90px;display:flex;align-items:flex-end;gap:3px;margin-top:8px;padding:6px 0}.cb{flex:1;display:flex;flex-direction:column;align-items:center}.cff{width:100%;border-radius:2px 2px 0 0;background:var(--accent);min-height:3px}.cff.cur{background:var(--green)}.ce{width:100%;height:2px;background:var(--dim);margin-top:2px}.cl{font-size:8px;color:var(--dim);margin-top:2px}.cv{font-size:9px;color:var(--muted);margin-top:1px}
.fg{margin-bottom:12px}.fl{font-size:13px;color:var(--muted);margin-bottom:5px}.fl .r{color:var(--red)}.fi{width:100%;padding:11px 13px;background:var(--bg);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:14px;outline:0}.fi:focus{border-color:var(--accent)}
.dr{display:flex;gap:10px;margin-bottom:12px}.dr input,.dr select{flex:1;padding:11px;background:var(--bg);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:13px}
.ckg{display:flex;flex-wrap:wrap;gap:5px;margin-top:3px}.ck{display:flex;align-items:center;gap:4px;font-size:12px;padding:5px 9px;background:var(--bg);border:1px solid var(--border);border-radius:7px;cursor:pointer}.ck input{display:none}.ck .bx{width:13px;height:13px;border:2px solid var(--border);border-radius:3px}.ck input:checked+.bx{background:var(--accent);border-color:var(--accent)}
.sub{width:100%;padding:13px;background:var(--accent);color:#000;border:0;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer}.sub:hover{background:#7dd3fc}
.rd{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:11px;font-size:13px;line-height:1.9}.rr{display:flex;justify-content:space-between;padding:3px 0}.rr .l{color:var(--muted)}.rr .v{font-weight:600}
.sb{text-align:center;padding:24px 14px}.sb .ic{font-size:34px;margin-bottom:6px}.sb .t{font-weight:600;font-size:15px;margin-bottom:6px}.sb .d{font-size:13px;color:var(--muted);line-height:1.8}
.gc{background:var(--gdim);border:1px solid rgba(52,211,153,.2);border-radius:12px;padding:13px}.gt{font-size:11px;color:var(--green);font-weight:600;margin-bottom:5px}.gx{font-size:14px;line-height:1.7}
.hi{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:10px 0;border-bottom:1px solid var(--border)}.hi:last-child{border-bottom:0}.hd{font-size:13px;font-weight:600}.hd .hsub{font-size:10px;color:var(--dim);font-weight:400;display:block}.hdata{font-size:12px;text-align:left;flex-basis:100%;margin-top:2px;color:var(--muted)}.hnull{color:var(--dim);font-style:italic;font-size:11px}.hnb{padding:2px 8px;border-radius:10px;font-size:11px;white-space:nowrap}.hn{background:rgba(167,139,250,.12);color:#a78bfa}.hp{background:var(--gdim);color:var(--green)}.hr{background:rgba(248,113,113,.12);color:var(--red)}
.mcard{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.mbox{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px}.mbox .ml{font-size:10px;color:var(--dim)}.mbox .mv{font-size:15px;font-weight:600;margin-top:2px}
.score{display:flex;justify-content:space-around;text-align:center;padding:8px 0}.score .num{font-size:32px;font-weight:700}.score .lb{font-size:11px;color:var(--dim)}
.bar{height:6px;background:var(--border);border-radius:3px;margin-top:4px}.bf{height:6px;border-radius:3px}
.tag{display:inline-block;padding:2px 7px;border-radius:6px;font-size:10px;margin-right:4px}.tag.ok{background:var(--gdim);color:var(--green)}.tag.warn{background:var(--ydim);color:var(--yellow)}.tag.bad{background:var(--redim);color:var(--red)}
.del-btn{background:0;border:0;color:var(--red);font-size:11px;cursor:pointer;padding:2px 6px;border-radius:4px}.del-btn:hover{background:var(--redim)}
.en-btn.active{background:var(--accent)!important;color:#000!important;border-color:var(--accent)!important}
.plan-day{border:1px solid var(--border);border-radius:10px;margin-bottom:8px;overflow:hidden}.plan-day-hd{background:var(--adim);padding:10px 14px;font-size:13px;font-weight:600;display:flex;justify-content:space-between;align-items:center}.plan-day-hd .focus{font-size:11px;color:var(--accent);font-weight:400}.plan-item{display:flex;align-items:center;padding:10px 14px;border-top:1px solid var(--border);gap:10px}.plan-item .idx{width:22px;height:22px;background:var(--bg);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--muted);flex-shrink:0}.plan-item .info{flex:1;min-width:0}.plan-item .nm{font-size:13px;font-weight:600}.plan-item .detail{font-size:11px;color:var(--dim);margin-top:2px}.plan-item .tag{flex-shrink:0}.plan-note{font-size:12px;color:var(--muted);padding:10px 14px;border-top:1px solid var(--border);background:var(--bg);line-height:1.6}
/* ===== 训练播放器 ===== */
.wp-overlay{position:fixed;inset:0;z-index:9998;background:var(--bg);display:none;flex-direction:column}
.wp-header{position:sticky;top:0;background:var(--card);border-bottom:1px solid var(--border);padding:10px 14px;display:flex;justify-content:space-between;align-items:center;z-index:10;flex-shrink:0}
.wp-body{flex:1;overflow-y:auto;padding:16px;-webkit-overflow-scrolling:touch}
.wp-bottom{position:sticky;bottom:0;background:var(--card);border-top:1px solid var(--border);padding:12px 16px;flex-shrink:0}
.wp-gif{width:200px;height:200px;object-fit:contain;border-radius:12px;background:#fff;margin:0 auto 12px;display:block}
.wp-target-box{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px;margin-bottom:12px}
.wp-dots{display:flex;gap:8px;justify-content:center;margin:10px 0}
.wp-dot{width:14px;height:14px;border-radius:50%;background:var(--border);transition:all .2s}
.wp-dot.done{background:var(--green)}
.wp-dot.active{background:var(--accent);transform:scale(1.2)}
.wp-set-form{display:flex;gap:12px;align-items:flex-end;justify-content:center;margin:12px 0}
.wp-input{width:90px;padding:12px 8px;background:var(--bg);border:2px solid var(--border);border-radius:10px;color:var(--text);font-size:18px;text-align:center;font-weight:600;outline:0}
.wp-input:focus{border-color:var(--accent)}
.wp-input-label{font-size:11px;color:var(--dim);text-align:center;margin-bottom:4px}
.wp-btn{padding:12px 20px;border:0;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;border:none}
.wp-btn-pri{background:var(--accent);color:#000}
.wp-btn-pri:active{transform:scale(.97)}
.wp-btn-gh{background:var(--bg);color:var(--muted);border:1px solid var(--border)}
.wp-btn-sm{padding:8px 14px;font-size:13px;border-radius:8px}
.wp-rest-box{position:fixed;inset:0;z-index:9999;background:rgba(15,23,42,.95);display:flex;align-items:center;justify-content:center;flex-direction:column;padding:20px}
.wp-rest-time{font-size:56px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--accent)}
.wp-rest-bar{height:8px;background:var(--bg);border-radius:4px;overflow:hidden;margin:12px 0;width:240px}
.wp-rest-fill{height:8px;border-radius:4px;transition:width .3s linear}
.wp-timer-big{font-size:56px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums;margin:20px 0}
.wp-prog-bar{height:8px;background:var(--bg);border-radius:4px;overflow:hidden;margin:8px 0}
.wp-prog-fill{height:8px;border-radius:4px;transition:width .3s}
.wp-session-banner{background:var(--gdim);border:1px solid rgba(52,211,153,.2);border-radius:10px;padding:10px 14px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.wp-play-btn{background:var(--accent);color:#000;border:0;border-radius:50%;width:30px;height:30px;font-size:11px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.wp-play-btn:active{transform:scale(.9)}
</style>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>
<!-- Auth Overlay -->
<div id="auth-overlay" style="display:flex;position:fixed;inset:0;background:var(--bg);z-index:9999;justify-content:center;align-items:center">
  <div style="width:90%;max-width:380px;text-align:center">
    <div style="font-size:28px;font-weight:700;margin-bottom:6px">体重控制 Agent</div>
    <div style="font-size:13px;color:var(--muted);margin-bottom:28px">登录后你的数据将云端同步，多设备访问</div>
    <div id="auth-form">
      <div class="fg" style="margin-bottom:12px"><input type="email" id="auth-email" class="fi" placeholder="邮箱" style="font-size:15px;padding:12px 14px"></div>
      <div class="fg" style="margin-bottom:12px"><input type="password" id="auth-pass" class="fi" placeholder="密码（至少6位）" style="font-size:15px;padding:12px 14px"></div>
      <div id="auth-error" style="display:none;font-size:12px;color:var(--red);margin-bottom:10px"></div>
      <button class="sub" id="auth-login-btn" onclick="handleAuth('login')" style="width:100%;padding:12px;font-size:15px;margin-bottom:10px">🔐 登录</button>
      <button class="sub" id="auth-signup-btn" onclick="handleAuth('signup')" style="width:100%;padding:12px;font-size:15px;background:var(--card);border:1px solid var(--border)">📝 注册新账户</button>
    </div>
    <div id="auth-loading" style="display:none;color:var(--muted);font-size:14px;padding:20px">⏳ 加载中...</div>
    <button onclick="skipAuth()" style="background:none;border:none;color:var(--dim);font-size:13px;cursor:pointer;padding:8px;margin-top:8px;text-decoration:underline">离线使用（仅本地数据）</button>
    <div style="font-size:11px;color:var(--dim);margin-top:16px;line-height:1.5">登录后数据云端同步；离线模式仅存本地浏览器</div>
  </div>
</div>

<div class="app">
<div class="hdr">
  <div class="hdr-l" onclick="openProfile()" style="cursor:pointer"><div class="av" id="hdr-av">C</div><span class="nm" id="hdr-name">未设置</span><span class="gl" id="hdr-goal">🎯 点击设置</span></div>
  <button class="hdr-r" onclick="openSettings()">⚙️ 设置</button>
</div>
<div class="tabs">
  <button class="tab active" data-p="o">📊概览</button>
  <button class="tab" data-p="r">📝录入</button>
  <button class="tab" data-p="p">📋报告</button>
  <button class="tab" data-p="h">📈历史</button>
  <button class="tab" data-p="a">🤖AI</button>
</div>

<!-- OVERVIEW — 动态渲染 -->
<div class="page active" id="p-o"><div id="overview-content"></div></div>

<!-- RECORD -->
<div class="page" id="p-r">

<!-- 子 Tab -->
<div class="tabs" style="padding:0 0 8px;gap:6px">
  <button class="tab active" data-sub="manual" onclick="switchRecTab('manual')">✍️ 手动录入</button>
  <button class="tab" data-sub="snap" onclick="switchRecTab('snap')">📸 截图识别</button>
</div>

<!-- 手动录入 -->
<div id="rec-manual">
<div class="card">
  <div class="ct">⚖️ 体重记录</div>
  <div class="dr">
    <input type="date" id="rd">
    <select id="rt"><option>早晨空腹</option><option>下午</option><option>晚上</option></select>
  </div>
  <div class="fg"><label class="fl"><span class="r">*</span> 体重（kg）</label><input type="number" id="rw" class="fi" placeholder="例: 60.6" step="0.1"></div>
  <div class="fg"><label class="fl">体脂率（%）</label><input type="number" id="rf" class="fi" step="0.1" placeholder="例: 35.6"></div>
  <div class="fg"><label class="fl">骨骼肌（kg）</label><input type="number" id="rm" class="fi" step="0.1" placeholder="例: 21.4"></div>
  <div class="fg"><label class="fl">腰臀比</label><input type="number" id="rwhtr" class="fi" step="0.01" placeholder="例: 0.91"></div>

  <div class="fg" style="margin-top:16px"><label class="fl">🌙 昨晚睡眠</label>
    <div class="dr">
      <select id="rss" class="fi"><option>7小时+（96分）</option><option>6-7小时（80-95分）</option><option>5-6小时（70-79分）</option><option>5小时以下（&lt;70分）</option></select>
      <input type="number" id="rsh" class="fi" placeholder="小时数" step="0.5">
    </div>
  </div>

  <div class="fg"><label class="fl">🏋️ 今天运动了吗？</label>
    <div class="ckg">
      <label class="ck"><input type="radio" name="ex" value="0" onchange="toggleExForm()"><span class="bx"></span>没动</label>
      <label class="ck"><input type="radio" name="ex" value="1" onchange="toggleExForm()" checked><span class="bx"></span>锻炼了</label>
    </div>
  </div>
  <div id="ex-form">
    <div class="fg">
      <label class="fl">🏋️ 力量训练 <span style="font-size:11px;color:var(--dim);font-weight:400">— 逐个添加动作，心率按本次训练填</span></label>
      <div id="str-list" style="margin-bottom:6px"><div style="color:var(--dim);font-size:12px;padding:6px">尚未添加动作</div></div>
      <div id="add-ex-row" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">
        <select id="add-equip" class="fi" onchange="updateExSelector()" style="flex:1;min-width:64px;padding:8px;font-size:12px">
          <option value="body weight">自重</option>
          <option value="dumbbell">哑铃</option>
          <option value="barbell">杠铃</option>
          <option value="cable">龙门架</option>
          <option value="machine">固定器械</option>
          <option value="band">弹力带</option>
          <option value="kettlebell">壶铃</option>
        </select>
        <select id="add-bp" class="fi" onchange="updateExSelector()" style="flex:1;min-width:64px;padding:8px;font-size:12px">
          <option value="chest">胸</option>
          <option value="back">背</option>
          <option value="shoulders">肩</option>
          <option value="biceps">二头</option>
          <option value="triceps">三头</option>
          <option value="quads_glutes">腿（股四/臀）</option>
          <option value="hamstrings_calves">腿（腘绳/小腿）</option>
          <option value="core">腰腹/核心</option>
          <option value="cardio">有氧/HIIT</option>
        </select>
        <select id="add-ex" class="fi" style="flex:2;min-width:96px;padding:8px;font-size:12px"></select>
        <input type="number" id="add-dur" class="fi" style="flex:0 0 44px;padding:8px;font-size:12px" placeholder="分钟" value="10" min="1">
        <input type="number" id="add-hr" class="fi" style="flex:0 0 50px;padding:8px;font-size:12px" placeholder="心率" min="40" max="220">
        <button onclick="addStrengthEntry()" style="flex:0 0 auto;padding:8px 12px;background:var(--accent);color:#000;border:0;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer">➕</button>
      </div>
      <div style="font-size:11px;color:var(--dim);margin-top:2px">心率 = 本次训练平均心率（Apple Fitness 自动记录，如127次/分），非必填</div>
      <div id="str-total" style="font-size:12px;color:var(--dim);margin-top:4px">力量小计：0 分钟</div>
    </div>

    <div class="fg" style="margin-top:14px">
      <label class="fl">🏃 有氧运动 <span style="font-size:11px;color:var(--dim);font-weight:400">— 逐个添加</span></label>
      <div id="cardio-list" style="margin-bottom:6px"><div style="color:var(--dim);font-size:12px;padding:6px">尚未添加有氧</div></div>
      <div style="display:flex;gap:6px;margin-top:6px">
        <select id="cardio-type" class="fi" style="flex:2;padding:8px;font-size:12px">
          <option value="treadmill">跑步机</option>
          <option value="outdoor_run">户外跑步</option>
          <option value="elliptical">椭圆机</option>
          <option value="rowing">划船机</option>
          <option value="spin_bike">动感单车</option>
          <option value="jump_rope">跳绳</option>
          <option value="swimming">游泳</option>
          <option value="brisk_walk">快走</option>
          <option value="stairs">爬楼梯</option>
        </select>
        <input type="number" id="cardio-dur" class="fi" style="flex:0 0 44px;padding:8px;font-size:12px" placeholder="分钟" value="20" min="1">
        <input type="number" id="cardio-hr" class="fi" style="flex:0 0 50px;padding:8px;font-size:12px" placeholder="心率" min="40" max="220">
        <button onclick="addCardioEntry()" style="flex:0 0 auto;padding:8px 12px;background:var(--accent);color:#000;border:0;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer">➕</button>
      </div>
      <div style="font-size:11px;color:var(--dim);margin-top:2px">心率 = 本次训练平均心率（Apple Fitness 自动记录，如144次/分），非必填</div>
      <div id="cardio-total" style="font-size:12px;color:var(--dim);margin-top:4px">有氧小计：0 分钟</div>
    </div>

    <div class="fg" style="margin-top:14px">
      <label class="fl">🌙 晨起生理指标 <span style="font-size:11px;color:var(--dim);font-weight:400">— Apple Watch 夜间监测，反映恢复状态</span></label>
      <div style="display:flex;gap:6px;margin-top:6px">
        <input type="number" id="ex-hrv" class="fi" style="flex:1;padding:8px;font-size:12px" placeholder="晨起HRV (ms)">
        <input type="number" id="ex-resting-hr" class="fi" style="flex:1;padding:8px;font-size:12px" placeholder="晨起静息心率 (bpm)">
        <input type="number" id="ex-sleep-hr" class="fi" style="flex:1;padding:8px;font-size:12px" placeholder="睡眠心率 (bpm)">
      </div>
      <div style="font-size:11px;color:var(--dim);margin-top:4px">HRV 偏低或静息心率偏高 → 恢复不足，建议降强度</div>
    </div>
    <div id="ex-summary" style="font-size:12px;color:var(--muted);margin-top:8px;min-height:18px"></div>
  </div>

  <div class="fg"><label class="fl">特殊情况</label>
    <div class="ckg">
      <label class="ck"><input type="checkbox"><span class="bx"></span>出差</label>
      <label class="ck"><input type="checkbox"><span class="bx"></span>聚餐</label>
      <label class="ck"><input type="checkbox"><span class="bx"></span>熬夜</label>
      <label class="ck"><input type="checkbox"><span class="bx"></span>压力大</label>
    </div>
  </div>
  <button class="sub" onclick="saveFormData();gp('p')">提交并生成报告</button>
</div>
</div><!-- /rec-manual -->

<!-- 截图识别 -->
<div id="rec-snap" style="display:none">
  <div class="card">
    <div class="ct">📸 截图批量识别</div>
    <div id="snap-drop" style="border:2px dashed var(--border);border-radius:12px;padding:28px 14px;text-align:center;cursor:pointer;transition:border-color .2s" onclick="document.getElementById('snap-file').click()">
      <div style="font-size:32px;margin-bottom:6px">📷</div>
      <div style="font-size:14px;font-weight:600;margin-bottom:3px">点击或拖拽截图到此处</div>
      <div style="font-size:12px;color:var(--dim)">支持体脂秤报告、Apple Watch 训练/睡眠截图，可多选</div>
      <input type="file" id="snap-file" accept="image/*" multiple style="display:none" onchange="handleSnapFiles(this.files)">
    </div>
    <div id="snap-previews" style="display:none;margin-top:10px"></div>
    <div id="snap-progress" style="display:none;margin-top:10px"></div>
    <div id="snap-results" style="display:none;margin-top:10px"></div>
  </div>
</div><!-- /rec-snap -->

</div>
<!-- REPORT — 动态渲染 -->
<div class="page" id="p-p"><div id="report-content"></div></div>

<!-- HISTORY — 动态渲染 -->
<div class="page" id="p-h">
<div class="card" id="h-body-scale">
  <div class="ct">⚖️ 体脂秤记录</div>
  <div id="h-body-scale-list" style="min-height:40px"></div>
</div>
<div class="card" id="h-exercise">
  <div class="ct">🏋️ 运动记录</div>
  <div id="h-exercise-list" style="min-height:40px"></div>
</div>
<div class="card" id="h-sleep">
  <div class="ct">🌙 睡眠记录</div>
  <div id="h-sleep-list" style="min-height:40px"></div>
</div>
<div class="callout blue" id="h-summary">
  <div class="ct2">📊 数据摘要</div>
  <div id="h-summary-text"></div>
</div>
</div>

<!-- AI 运动计划 -->
<div class="page" id="p-a">
<!-- 身体状态 -->
<div class="card" id="ai-state-card">
  <div class="ct">🩺 当前身体状态</div>
  <div class="fg" id="ai-cycle-row" style="display:none"><label class="fl">月经周期</label>
    <select id="ai-cycle" class="fi">
      <option value="">无月经 / 跳过</option>
      <option value="follicular">卵泡期（经后第1-13天）</option>
      <option value="ovulation">排卵期（第14天左右）</option>
      <option value="luteal">黄体期（第15-28天）</option>
      <option value="menstrual">月经期（经期中）</option>
    </select>
  </div>
  <div class="fg"><label class="fl">精力水平 <span style="font-size:11px;color:var(--dim)">1=很累 5=精力充沛</span></label>
    <div style="display:flex;gap:4px;margin-top:4px">
      <script>for(let i=1;i<=5;i++){document.write('<button class="en-btn" data-en="'+i+'" style="flex:1;padding:9px;background:var(--bg);border:1px solid var(--border);border-radius:8px;color:var(--muted);font-size:16px;cursor:pointer;transition:.2s" onclick="setEnergy('+i+',this)">'+i+'</button>');}</script>
    </div>
    <input type="hidden" id="ai-energy" value="3">
  </div>
  <div class="fg"><label class="fl">伤病/不适备注</label>
    <input type="text" id="ai-injury" class="fi" placeholder="例：右膝不适、腰有点酸、空腹中…">
  </div>
  <div class="fg"><label class="fl">可用器械 <span style="font-size:11px;color:var(--dim)">多选</span></label>
    <div class="ckg" id="ai-equip-check" style="margin-top:4px">
      <label class="ck"><input type="checkbox" value="body weight" checked><span class="bx"></span>自重</label>
      <label class="ck"><input type="checkbox" value="dumbbell" checked><span class="bx"></span>哑铃</label>
      <label class="ck"><input type="checkbox" value="band" checked><span class="bx"></span>弹力带</label>
      <label class="ck"><input type="checkbox" value="barbell"><span class="bx"></span>杠铃</label>
      <label class="ck"><input type="checkbox" value="kettlebell"><span class="bx"></span>壶铃</label>
      <label class="ck"><input type="checkbox" value="cable"><span class="bx"></span>龙门架</label>
      <label class="ck"><input type="checkbox" value="machine"><span class="bx"></span>固定器械</label>
    </div>
  </div>
  <button class="sub" id="ai-plan-btn" onclick="runAIPlan()" style="margin-top:12px">🚀 生成4周渐进计划</button>
</div>

<div id="ai-loading-area" style="display:none;text-align:center;padding:28px;color:var(--muted)">
  <div style="font-size:32px;margin-bottom:10px">⏳</div>
  <div style="font-size:14px">正在为你生成个性化的运动计划...</div>
  <div style="font-size:11px;color:var(--dim);margin-top:6px">大概需要 5-10 秒</div>
</div>
<div id="ai-error-area" style="display:none;text-align:center;padding:20px;color:var(--red);font-size:13px"></div>
<div id="ai-plan-area" style="display:none"></div>
<div id="ai-empty" style="text-align:center;padding:24px 14px"><div style="font-size:34px;margin-bottom:6px">🏋️</div><div style="font-weight:600;font-size:15px;margin-bottom:6px">AI 运动计划生成器</div><div style="font-size:13px;color:var(--muted);line-height:1.8">填写上方身体状态，点击生成按钮，AI 会根据你的数据和目标为你制定个性化运动计划</div></div>
</div>
</div>
