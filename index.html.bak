function exToCn(en) {
  if (!en || en === '') return en || '';
  // 精确匹配（不区分大小写）
  if (EX_CN[en]) return EX_CN[en];
  if (EX_CN[en.toLowerCase()]) return EX_CN[en.toLowerCase()];
  const words = en.replace(/v\.\s*\d+/gi, '').trim().split(/\s+/).map(w => w.toLowerCase());
  // 优先匹配核心动作组合（verb+body, body+verb 等2-3词组合）
  const CORE_PRIORITY = ['press','raise','curl','row','extension','fly','flye','push','pull',
    'squat','lunge','deadlift','bench','dip','crunch','plank','kickback','pulldown',
    'pushdown','thrust','shrug','clean','snatch','swing','jerk','press','press',
    'leg press','leg curl','leg extension','chest press','shoulder press','bicep curl',
    'tricep extension','lateral raise','front raise','rear raise','lat pulldown',
    'face pull','hip thrust','glute bridge','calf raise','good morning','upright row'];
  // 先尝试2-3词组合（从后往前，优先核心动作）
  if (words.length >= 3) {
    for (let i = words.length - 3; i >= 0; i--) {
      const p3 = words.slice(i, i+3).join(' ');
      if (EX_CN[p3]) return EX_CN[p3];
    }
  }
  if (words.length >= 2) {
    for (let i = words.length - 2; i >= 0; i--) {
      const p2 = words.slice(i, i+2).join(' ');
      if (EX_CN[p2]) return EX_CN[p2];
    }
  }
  // 单词匹配：优先核心动作词，再从后往前兜底
  for (const core of CORE_PRIORITY) {
    for (const w of words) {
      if (w === core && EX_CN[w]) return EX_CN[w];
    }
  }
  for (let i = words.length - 1; i >= 0; i--) {
    if (EX_CN[words[i]]) return EX_CN[words[i]];
  }
  // 无匹配时，原样返回英文
  return en;
}

let strengthEntries = [];

function toggleExForm() {
  const v = document.querySelector('input[name="ex"]:checked');
  document.getElementById('ex-form').style.display = v && v.value === '1' ? 'block' : 'none';
}

function renderStars(n) {
  return '★'.repeat(n) + '☆'.repeat(4 - n);
}

function updateExSelector() {
  const equip = document.getElementById('add-equip').value;
  const bp = document.getElementById('add-bp').value;
  const sel = document.getElementById('add-ex');
  let filtered = EXERCISES.filter(e => e.equipment === equip && e.group === bp);
  // compound 优先排序
  filtered.sort((a, b) => {
    if (a.mechanics_type === 'compound' && b.mechanics_type !== 'compound') return -1;
    if (a.mechanics_type !== 'compound' && b.mechanics_type === 'compound') return 1;
    return 0;
  });
  sel.innerHTML = filtered.length > 0
    ? filtered.map(e => {
        const label = (e.name_cn && e.name_cn !== e.name_en) ? e.name_cn : exToCn(e.name_en);
        const tag = e.mechanics_type === 'compound' ? '★' : '';
        return `<option value="${e.name_en}">${tag} ${label}</option>`;
      }).join('')
    : '<option value="">无匹配动作</option>';
}

function addStrengthEntry() {
  const equip = document.getElementById('add-equip').value;
  const ex = document.getElementById('add-ex').value;
  const dur = parseInt(document.getElementById('add-dur').value) || 10;
  const hr = parseInt(document.getElementById('add-hr').value) || 0;
  if (!ex) return;
  const exercise = EXERCISES.find(e => e.name_en === ex && e.equipment === equip);
  if (!exercise) return;
  strengthEntries.push({ name_cn: exercise.name_cn, name_en: exercise.name_en, equipment: exercise.equipment, group: exercise.group, duration: dur, hr: hr });
  renderStrengthList();
  updateExSummary();
  if (document.getElementById('add-hr').value) document.getElementById('add-hr').value = '';
}

function removeStrengthEntry(i) {
  strengthEntries.splice(i, 1);
  renderStrengthList();
  updateExSummary();
}

function renderStrengthList() {
  const list = document.getElementById('str-list');
  const total = document.getElementById('str-total');
  if (strengthEntries.length === 0) {
    list.innerHTML = '<div style="color:var(--dim);font-size:12px;padding:6px">尚未添加动作</div>';
    total.textContent = '力量小计：0 分钟';
    return;
  }
  list.innerHTML = strengthEntries.map((e, i) => {
    const label = (e.name_cn && e.name_cn !== e.name_en) ? e.name_cn : exToCn(e.name_en);
    const hrTag = e.hr ? `<span style="font-size:11px;color:var(--green)">❤️${e.hr}</span>` : '';
    return `<div style="display:flex;align-items:center;gap:8px;padding:6px 8px;background:var(--bg);border:1px solid var(--border);border-radius:7px;margin-bottom:4px">
      <span style="flex:1;font-size:13px">${label}</span>
      <span style="font-size:10px;color:var(--dim)">${EQUIP_CN[e.equipment]||e.equipment}</span>
      <span style="font-size:12px;font-weight:600;color:var(--accent)">${e.duration}min</span>
      ${hrTag}
      <span style="cursor:pointer;font-size:14px;color:var(--red);padding:2px 6px" onclick="removeStrengthEntry(${i})">✕</span>
    </div>`;
  }).join('');
  total.textContent = '力量小计：' + strengthEntries.reduce((s, e) => s + e.duration, 0) + ' 分钟';
}

let cardioEntries = [];

function addCardioEntry() {
  const sel = document.getElementById('cardio-type');
  const name = sel.options[sel.selectedIndex].text;
  const dur = parseInt(document.getElementById('cardio-dur').value) || 0;
  const hr = parseInt(document.getElementById('cardio-hr').value) || 0;
  if (dur <= 0) return;
  cardioEntries.push({ name, duration: dur, hr: hr });
  renderCardioList();
  updateExSummary();
  if (document.getElementById('cardio-hr').value) document.getElementById('cardio-hr').value = '';
}

function removeCardioEntry(i) {
  cardioEntries.splice(i, 1);
  renderCardioList();
  updateExSummary();
}

function renderCardioList() {
  const list = document.getElementById('cardio-list');
  const total = document.getElementById('cardio-total');
  if (cardioEntries.length === 0) {
    list.innerHTML = '<div style="color:var(--dim);font-size:12px;padding:6px">尚未添加有氧</div>';
    total.textContent = '有氧小计：0 分钟';
    return;
  }
  list.innerHTML = cardioEntries.map((e, i) => {
    const hrTag = e.hr ? `<span style="font-size:11px;color:var(--green)">❤️${e.hr}</span>` : '';
    return `<div style="display:flex;align-items:center;gap:8px;padding:6px 8px;background:var(--bg);border:1px solid var(--border);border-radius:7px;margin-bottom:4px">
      <span style="flex:1;font-size:13px">🏃 ${e.name}</span>
      <span style="font-size:12px;font-weight:600;color:var(--green)">${e.duration}min</span>
      ${hrTag}
      <span style="cursor:pointer;font-size:14px;color:var(--red);padding:2px 6px" onclick="removeCardioEntry(${i})">✕</span>
    </div>`;
  }).join('');
  total.textContent = '有氧小计：' + cardioEntries.reduce((s, e) => s + e.duration, 0) + ' 分钟';
}

function updateExSummary() {
  const strMin = strengthEntries.reduce((s, e) => s + e.duration, 0);
  const cardioMin = cardioEntries.reduce((s, e) => s + e.duration, 0);
  const total = strMin + cardioMin;
  const el = document.getElementById('ex-summary');
  if (total === 0) {
    el.textContent = '未添加运动';
  } else {
    let labels = [];
    if (strMin > 0) labels.push('力量 ' + strMin + 'min');
    if (cardioMin > 0) labels.push('有氧 ' + cardioMin + 'min');
    el.innerHTML = '✅ 总时长 <strong>' + total + '</strong> 分钟（' + labels.join(' + ') + '）';
  }
}

function selectGender(value) {
  const r = document.querySelector(`input[name=pf-gender][value="${value}"]`);
  if (r) { r.checked = true; updateGenderLabels(); toggleCycleRow(); }
}
function selectCycle(value) {
  const r = document.querySelector(`input[name=pf-cycle][value="${value}"]`);
  if (r) { r.checked = true; updateCycleLabels(); }
}
function gp(n){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('p-'+n).classList.add('active');
  document.querySelector('[data-p="'+n+'"]').classList.add('active');
  try {
    if (n === 'r') { toggleExForm(); }
    if (n === 'h') { renderHistory(); }
    if (n === 'o') { renderOverview(); }
    if (n === 'p') { renderReport(); }
    if (n === 'a') { renderAIPage(); }
  } catch(e) { console.error('gp error:', e); }
}

document.querySelectorAll('.tab[data-p]').forEach(t=>t.addEventListener('click',()=>gp(t.dataset.p)));

// ===== 数据持久化 =====
const STORAGE_KEY = 'bc_agent_records_v9';

const SEED_BODY_SCALE = [];

const SEED_EXERCISE = [];

const SEED_SLEEP = [];

function getDB() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch(e) { console.error('getDB error:', e); }
  return { bodyScale: [], exercise: [], sleep: [] };
}

function saveDB(db) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
  scheduleCloudSync();
}

function parseSleepScore(text) {
  const m = text.match(/([\d.]+)\s*分/);
  return m ? parseInt(m[1]) : 70;
}

function parseSleepHours(text) {
  if (text.includes('7小时+')) return 7.5;
  const m = text.match(/([\d.]+)-([\d.]+)小时/);
  if (m) return (parseFloat(m[1]) + parseFloat(m[2])) / 2;
  return 5;
}

// === 截图识别功能 ===
let snapFiles = [];
let snapParsed = [];

function switchRecTab(tab) {
  document.querySelectorAll('[data-sub]').forEach(b => b.classList.toggle('active', b.dataset.sub === tab));
  document.getElementById('rec-manual').style.display = tab === 'manual' ? '' : 'none';
  document.getElementById('rec-snap').style.display = tab === 'snap' ? '' : 'none';
}

function handleSnapFiles(files) {
  const arr = Array.from(files).filter(f => f.type.startsWith('image/'));
  arr.forEach(f => snapFiles.push(f));
  renderSnapPreviews();
}

function renderSnapPreviews() {
  const box = document.getElementById('snap-previews');
  if (!snapFiles.length) { box.style.display = 'none'; return; }
  box.style.display = '';
  box.innerHTML = '<div style="font-size:11px;color:var(--muted);margin-bottom:6px">已选 ' + snapFiles.length + ' 张截图，点击 ❌ 移除</div>';
  box.innerHTML += '<div style="display:flex;flex-wrap:wrap;gap:6px">' + snapFiles.map((f, i) =>
    '<div style="position:relative;width:70px;height:70px;border:1px solid var(--border);border-radius:8px;overflow:hidden">' +
    '<img src="' + URL.createObjectURL(f) + '" style="width:100%;height:100%;object-fit:cover">' +
    '<button onclick="removeSnap(' + i + ')" style="position:absolute;top:1px;right:1px;background:rgba(0,0,0,.7);color:#fff;border:0;border-radius:50%;width:18px;height:18px;font-size:10px;cursor:pointer">×</button>' +
    '</div>'
  ).join('') + '</div>';
  box.innerHTML += '<button class="sub" style="margin-top:10px" onclick="recognizeSnaps()">🔍 识别并录入</button>';
  box.innerHTML += '<div style="font-size:11px;color:var(--dim);margin-top:6px;line-height:1.5">将调用 AI 视觉模型解析截图，自动提取体重/体脂/骨骼肌/腰臀比/训练/睡眠数据</div>';
}

function removeSnap(idx) {
  snapFiles.splice(idx, 1);
  renderSnapPreviews();
}

function fileToBase64(file) {
  return new Promise(res => {
    const r = new FileReader();
    r.onload = () => res(r.result.split(',')[1]);
    r.readAsDataURL(file);
  });
}

async function recognizeSnaps() {
  if (!snapFiles.length) return;
  const key = localStorage.getItem('ai_vision_key') || localStorage.getItem('bc_agent_deepseek_key') || '';
  if (!key) { showToast('请先在 AI 页面设置 Vision API Key'); gp('a'); return; }
  const prog = document.getElementById('snap-progress');
  const results = document.getElementById('snap-results');
  prog.style.display = '';
  prog.innerHTML = '<div class="callout blue"><div class="ct2">⏳ 正在识别...</div><div id="snap-prog-text">准备中</div></div>';
  results.style.display = 'none';
  snapParsed = [];
      const PROXY_URL = 'https://1469564893-2azg8ebcd5.ap-guangzhou.tencentscf.com';
  const apiUrl = localStorage.getItem('ai_vision_url') || PROXY_URL;
  const model = localStorage.getItem('ai_vision_model') || 'sensenova-6.8-flash-lite';
  const isProxy = apiUrl.indexOf('tencentscf') > -1 || apiUrl.indexOf('scf') > -1 || apiUrl.indexOf('worker') > -1;
  for (let i = 0; i < snapFiles.length; i++) {
    document.getElementById('snap-prog-text').textContent = '识别第 ' + (i+1) + '/' + snapFiles.length + ' 张...';
    try {
      const b64 = await fileToBase64(snapFiles[i]);
      const reqBody = {
        model: model,
        messages: [{ role: 'user', content: [
          { type: 'image', source: { type: 'base64', media_type: snapFiles[i].type, data: b64 } },
          { type: 'text', text: '这是健康数据截图。请提取数据并返回JSON数组，每条记录一个对象。体脂秤截图提取:date(YYYY-MM-DD),time(HH:MM),weight(kg),bodyFat(%),muscle(kg),fatMass(kg),whtr,recType=bodyScale。Apple Watch训练截图提取:date,time(如12:17-13:11),name(训练名称如传统力量/功能性力量/室内步行/户外步行/踏步机),type(力量/有氧),dur(分钟),cal(总千卡),hr(平均心率),recType=exercise。睡眠截图提取:date,hours(小数),score(评分数字或null),recType=sleep。只返回JSON数组，不要解释。如果无法识别返回[]。' }
        ]}],
        temperature: 0.1
      };
      // 代理模式：{auth_token, req_body}；直连模式：OpenAI 格式 + Bearer
      const headers = isProxy ? { 'Content-Type': 'application/json' } : { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key };
      const body = isProxy ? JSON.stringify({ auth_token: key, req_body: reqBody }) : JSON.stringify(reqBody);
      const resp = await fetch(apiUrl, { method: 'POST', headers: headers, body: body });
      const data = await resp.json();
      if (!resp.ok) {
        const errMsg = data?.error?.message || data?.message || ('HTTP ' + resp.status);
        showToast('⚠️ 识别失败: ' + errMsg);
        console.error('snap http err', resp.status, data);
        continue;
      }
      const text = data.choices?.[0]?.message?.content || '[]';
      const jsonMatch = text.match(/\[[\s\S]*\]/);
      const parsed = jsonMatch ? JSON.parse(jsonMatch[0]) : [];
      snapParsed.push(...parsed);
    } catch(e) {
      console.error('snap err', e);
      showToast('⚠️ 网络错误: ' + (e.message || e) + '（检查代理地址）');
    }
  }
  prog.style.display = 'none';
  renderSnapResults();
}

function renderSnapResults() {
  const box = document.getElementById('snap-results');
  if (!snapParsed.length) {
    box.style.display = '';
    box.innerHTML = '<div class="callout red"><div class="ct2">⚠️ 未能识别出数据</div><div>请确认截图清晰，或检查 API Key 设置</div></div>';
    return;
  }
  box.style.display = '';
  let html = '<div class="callout green"><div class="ct2">✅ 识别到 ' + snapParsed.length + ' 条数据</div></div>';
  html += '<div style="font-size:11px;color:var(--dim);margin-bottom:6px">请核对数据，可修改后批量录入</div>';
  snapParsed.forEach((r, i) => {
    const rt = r.recType || r.type;
    const typeLabel = rt === 'bodyScale' ? '⚖️体脂秤' : rt === 'exercise' ? '🏋️训练' : '🌙睡眠';
    const typeColor = rt === 'bodyScale' ? 'var(--accent)' : rt === 'exercise' ? 'var(--green)' : 'var(--purple)';
    html += '<div class="card" style="padding:10px;margin-bottom:6px;border-left:3px solid ' + typeColor + '">';
    html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px"><span style="font-size:12px;font-weight:600;color:' + typeColor + '">' + typeLabel + '</span><button class="del-btn" onclick="removeParsed(' + i + ')">移除</button></div>';
    if (rt === 'bodyScale') {
      html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:4px">';
      html += '<label style="font-size:11px">日期<input value="' + (r.date||'') + '" onchange="snapParsed['+i+'].date=this.value" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">时间<input value="' + (r.time||'') + '" onchange="snapParsed['+i+'].time=this.value" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">体重(kg)<input type="number" step="0.1" value="' + (r.weight||'') + '" onchange="snapParsed['+i+'].weight=parseFloat(this.value)" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">体脂率(%)<input type="number" step="0.1" value="' + (r.bodyFat||'') + '" onchange="snapParsed['+i+'].bodyFat=parseFloat(this.value)" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">骨骼肌(kg)<input type="number" step="0.1" value="' + (r.muscle||'') + '" onchange="snapParsed['+i+'].muscle=parseFloat(this.value)" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">腰臀比<input type="number" step="0.01" value="' + (r.whtr||'') + '" onchange="snapParsed['+i+'].whtr=parseFloat(this.value)" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '</div>';
    } else if (rt === 'exercise') {
      html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:4px">';
      html += '<label style="font-size:11px">日期<input value="' + (r.date||'') + '" onchange="snapParsed['+i+'].date=this.value" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">时间<input value="' + (r.time||'') + '" onchange="snapParsed['+i+'].time=this.value" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">名称<input value="' + (r.name||'') + '" onchange="snapParsed['+i+'].name=this.value" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">类型<input value="' + (r.type2||r.subType||'') + '" onchange="snapParsed['+i+'].type2=this.value" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">时长(分)<input type="number" value="' + (r.dur||'') + '" onchange="snapParsed['+i+'].dur=parseInt(this.value)" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">千卡<input type="number" value="' + (r.cal||'') + '" onchange="snapParsed['+i+'].cal=parseInt(this.value)" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">心率<input type="number" value="' + (r.hr||'') + '" onchange="snapParsed['+i+'].hr=parseInt(this.value)" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '</div>';
    } else if (rt === 'sleep') {
      html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:4px">';
      html += '<label style="font-size:11px">日期<input value="' + (r.date||'') + '" onchange="snapParsed['+i+'].date=this.value" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">小时数<input type="number" step="0.01" value="' + (r.hours||'') + '" onchange="snapParsed['+i+'].hours=parseFloat(this.value)" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '<label style="font-size:11px">评分<input type="number" value="' + (r.score||'') + '" onchange="snapParsed['+i+'].score=this.value?parseInt(this.value):null" class="fi" style="padding:6px;font-size:12px"></label>';
      html += '</div>';
    }
    html += '</div>';
  });
  html += '<button class="sub" onclick="saveSnapData()">✅ 确认录入全部</button>';
  box.innerHTML = html;
}

function removeParsed(idx) {
  snapParsed.splice(idx, 1);
  renderSnapResults();
}

function saveSnapData() {
  const db = getDB();
  let added = 0;
  snapParsed.forEach(r => {
    const rt = r.recType || r.type;
    if (rt === 'bodyScale') {
      const exists = db.bodyScale.find(x => x.date === r.date);
      if (!exists) {
        db.bodyScale.push({ date:r.date, time:r.time, day:'', weight:r.weight, bodyFat:r.bodyFat, muscle:r.muscle, fatMass:r.fatMass||0, whtr:r.whtr, note:'截图识别' });
        added++;
      } else {
        Object.assign(exists, { weight:r.weight, bodyFat:r.bodyFat, muscle:r.muscle, fatMass:r.fatMass||0, whtr:r.whtr, note:(exists.note||'')+' | 截图更新' });
        added++;
      }
    } else if (rt === 'exercise') {
      const exType = r.type || r.type2 || r.subType || (r.name && (r.name.includes('步行') || r.name.includes('踏步')) ? '有氧' : '力量');
      const key = r.date + '_' + r.time;
      const exists = db.exercise.find(x => x.date + '_' + x.time === key);
      if (!exists) {
        db.exercise.push({ date:r.date, time:r.time, name:r.name, type:exType, dur:r.dur, cal:r.cal, hr:r.hr });
        added++;
      } else { Object.assign(exists, { name:r.name, type:exType, dur:r.dur, cal:r.cal, hr:r.hr }); added++; }
    } else if (rt === 'sleep') {
      const exists = db.sleep.find(x => x.date === r.date);
      if (!exists) { db.sleep.push({ date:r.date, hours:r.hours, score:r.score }); added++; }
      else { exists.hours = r.hours; if (r.score) exists.score = r.score; added++; }
    }
  });
  db.bodyScale.sort((a,b) => a.date.localeCompare(b.date));
  db.exercise.sort((a,b) => a.date.localeCompare(b.date));
  db.sleep.sort((a,b) => a.date.localeCompare(b.date));
  saveDB(db);
  showToast('✅ 录入 ' + added + ' 条数据');
  snapFiles = []; snapParsed = [];
  document.getElementById('snap-previews').style.display = 'none';
  document.getElementById('snap-results').style.display = 'none';
  renderOverview(); renderHistory();
  switchRecTab('manual');
  gp('o');
}

// 拖拽上传
document.addEventListener('DOMContentLoaded', function() {
  const drop = document.getElementById('snap-drop');
  if (!drop) return;
  drop.addEventListener('dragover', e => { e.preventDefault(); drop.style.borderColor = 'var(--accent)'; });
  drop.addEventListener('dragleave', () => { drop.style.borderColor = 'var(--border)'; });
  drop.addEventListener('drop', e => { e.preventDefault(); drop.style.borderColor = 'var(--border)'; handleSnapFiles(e.dataTransfer.files); });
});

function saveFormData() {
  const date = document.getElementById('rd').value;
  if (!date) { showToast('请选择日期'); return; }
  const db = getDB();
  const weight = parseFloat(document.getElementById('rw').value);
  const bodyFat = parseFloat(document.getElementById('rf').value);
  const muscle = parseFloat(document.getElementById('rm').value);
  const whtr = parseFloat(document.getElementById('rwhtr').value);

  // 体脂秤记录
  if (weight > 0) {
    const bIdx = db.bodyScale.findIndex(r => r.date === date);
    const bRec = { date, time: document.getElementById('rt').value, weight, bodyFat, muscle, whtr, fatMass: weight * bodyFat / 100 };
    if (bIdx >= 0) db.bodyScale[bIdx] = { ...db.bodyScale[bIdx], ...bRec };
    else db.bodyScale.push(bRec);
  }

    // 运动记录
    const hasEx = document.querySelector('input[name="ex"]:checked').value === '1';
    if (hasEx) {
      // 晨起生理指标
      const hrv = parseInt(document.getElementById('ex-hrv').value) || null;
      const restingHr = parseInt(document.getElementById('ex-resting-hr').value) || null;
      const sleepHr = parseInt(document.getElementById('ex-sleep-hr').value) || null;
      strengthEntries.forEach(e => {
        db.exercise.push({ date, time: '录入', name: e.name_cn, type: '力量', dur: e.duration, hr: e.hr || null, hrv, restingHr, sleepHr });
      });
      cardioEntries.forEach(e => {
        db.exercise.push({ date, time: '录入', name: e.name, type: '有氧', dur: e.duration, hr: e.hr || null, hrv, restingHr, sleepHr });
      });
    }
  // 睡眠记录
  const sleepSel = document.getElementById('rss');
  const sleepText = sleepSel.options[sleepSel.selectedIndex].text;
  const sleepHours = parseFloat(document.getElementById('rsh').value) || parseSleepHours(sleepText);
  const sleepScore = parseSleepScore(sleepText);
  if (sleepHours > 0) {
    const sIdx = db.sleep.findIndex(r => r.date === date);
    const sRec = { date, hours: sleepHours, score: sleepScore };
    if (sIdx >= 0) db.sleep[sIdx] = { ...db.sleep[sIdx], ...sRec };
    else db.sleep.push(sRec);
  }

  db.bodyScale.sort((a,b) => a.date.localeCompare(b.date));
  db.exercise.sort((a,b) => a.date.localeCompare(b.date));
  db.sleep.sort((a,b) => a.date.localeCompare(b.date));
  saveDB(db);
  strengthEntries = [];
  cardioEntries = [];
  document.getElementById('str-list').innerHTML = '<div style="color:var(--dim);font-size:12px;padding:6px">尚未添加动作</div>';
  document.getElementById('cardio-list').innerHTML = '<div style="color:var(--dim);font-size:12px;padding:6px">尚未添加有氧</div>';
  document.getElementById('str-total').textContent = '力量小计：0 分钟';
  document.getElementById('cardio-total').textContent = '有氧小计：0 分钟';
  document.getElementById('ex-summary').textContent = '';
  document.getElementById('ex-hrv').value = '';
  document.getElementById('ex-resting-hr').value = '';
  document.getElementById('ex-sleep-hr').value = '';
  showToast('✅ 数据已保存');
  renderOverview();
  renderReport();
}

// ===== 历史记录渲染 =====
function fmtDate(iso) {
  const d = new Date(iso + 'T00:00:00');
  return (d.getMonth()+1) + '/' + d.getDate();
}

function renderHistory() {
  const db = getDB();
  const bs = db.bodyScale;
  const ex = db.exercise;
  const sl = db.sleep;

  // 体脂秤
  const bsList = document.getElementById('h-body-scale-list');
  const sorted = [...bs].sort((a,b)=>b.date.localeCompare(a.date));
  bsList.innerHTML = sorted.length === 0
    ? '<div style="color:var(--dim);font-size:12px;padding:10px;text-align:center">暂无记录</div>'
    : sorted.map(r => {
        const top = r.date === sorted[0].date ? '最新' : (r.note||'');
        const tag = top ? `<span class="hnb ${top==='最新'?'hp': top.includes('最低')?'hr':'hn'}">${top}</span>` : '';
        return `<div class="hi"><div class="hd">${fmtDate(r.date)}<span class="hsub">${r.time||''}</span></div><div class="hdata">${r.weight}kg · ${r.bodyFat||'-'}% · 骨肌 ${r.muscle||'-'} · 体脂 ${(r.fatMass||r.weight*(r.bodyFat||0)/100).toFixed(1)} · WHtR ${r.whtr||'-'}</div>${tag}<button class="del-btn" onclick="deleteBodyScale('${r.date}')">✕</button></div>`;
      }).join('');
  document.querySelector('#h-body-scale .ct').textContent = '⚖️ 体脂秤记录（' + sorted.length + ' 次）';

  // 运动记录
  const exList = document.getElementById('h-exercise-list');
  const exSorted = [...ex].sort((a,b)=>b.date.localeCompare(a.date));
  exList.innerHTML = exSorted.length === 0
    ? '<div style="color:var(--dim);font-size:12px;padding:10px;text-align:center">暂无记录</div>'
    : exSorted.map((r, i) => {
        const tagTxt = r.type === '力量' ? '力量' : '有氧';
        const tagC = r.type === '力量' ? 'hn' : 'hn';
        const hrStr = r.hr ? ` · ❤️${r.hr}bpm` : '';
        const hrvStr = r.hrv ? ` · HRV${r.hrv}ms` : '';
        const calStr = r.cal ? ` · ${r.cal}千卡` : '';
        const detail = `${r.name} ${r.dur}分${hrStr}${calStr}${hrvStr}`;
        return `<div class="hi"><div class="hd">${fmtDate(r.date)}<span class="hsub">${r.time||''}</span></div><div class="hdata">${detail}</div><span class="hnb ${tagC}">${tagTxt}</span><button class="del-btn" onclick="deleteExercise('${r.date}','${r.name}')">✕</button></div>`;
      }).join('');
  document.querySelector('#h-exercise .ct').textContent = '🏋️ 运动记录（' + exSorted.length + ' 次）';

  // 睡眠记录
  const slList = document.getElementById('h-sleep-list');
  const slSorted = [...sl].sort((a,b)=>b.date.localeCompare(a.date));
  slList.innerHTML = slSorted.length === 0
    ? '<div style="color:var(--dim);font-size:12px;padding:10px;text-align:center">暂无记录</div>'
    : slSorted.map(r => {
        const h = Math.floor(r.hours);
        const m = Math.round((r.hours - h) * 60);
        const label = r.score >= 90 ? '非常好' : r.score >= 80 ? '高' : r.score >= 70 ? '一般' : '偏低';
        const tagC = r.score >= 90 ? 'hp' : r.score >= 80 ? 'hn' : r.score >= 70 ? 'hn' : 'hr';
        const scoreHtml = r.score >= 90 ? `<strong style="color:var(--green)">${r.score} 分</strong>` : r.score <= 70 ? `<strong style="color:var(--red)">${r.score} 分</strong>` : `${r.score} 分`;
        return `<div class="hi"><div class="hd">${fmtDate(r.date)}</div><div class="hdata">${h}h${m}m · ${scoreHtml}</div><span class="hnb ${tagC}">${label}</span><button class="del-btn" onclick="deleteSleep('${r.date}')">✕</button></div>`;
      }).join('');
  const slMin = fmtDate(slSorted.length > 0 ? slSorted[slSorted.length-1].date : '');
  const slMax = fmtDate(slSorted.length > 0 ? slSorted[0].date : '');
  document.querySelector('#h-sleep .ct').textContent = '🌙 睡眠记录' + (slSorted.length > 0 ? '（' + slMin + '-' + slMax + '）' : '');

  // 摘要
  const first = bs.length > 0 ? bs[0] : null;
  const last = bs.length > 0 ? bs[bs.length-1] : null;
  const wtChange = first && last ? (last.weight - first.weight).toFixed(1) : '-';
  const fatChange = first && last && first.fatMass && last.fatMass ? (last.fatMass - first.fatMass).toFixed(1) : '-';
  const muscleChange = first && last && first.muscle && last.muscle ? (last.muscle - first.muscle).toFixed(1) : '-';
  const slScored = sl.filter(r => r.score != null);
  const avgSleep = slScored.length > 0 ? (slScored.reduce((s,r)=>s+r.score,0)/slScored.length).toFixed(1) : '-';
  document.getElementById('h-summary-text').innerHTML =
    `<strong>${bs.length} 次</strong>体脂秤 + <strong>${ex.length} 次</strong>运动 + <strong>${sl.length} 天</strong>睡眠<br>` +
    `体重 ${first&&last ? first.weight + '→' + last.weight + 'kg' : '-'}` +
    (wtChange !== '-' ? (parseFloat(wtChange) < 0 ? '（<span style="color:var(--green)">↓' + Math.abs(parseFloat(wtChange)) + 'kg</span>）' : parseFloat(wtChange) > 0 ? '（<span style="color:var(--red)">↑' + wtChange + 'kg</span>）' : '（持平）') : '') +
    ` | 体脂肪 ${fatChange !== '-' ? (parseFloat(fatChange) < 0 ? '<span style="color:var(--green)">↓' + Math.abs(parseFloat(fatChange)) + 'kg</span>' : parseFloat(fatChange) > 0 ? '<span style="color:var(--red)">↑' + fatChange + 'kg</span>' : '持平') : '-'}` +
    ` | 骨骼肌 ${muscleChange !== '-' ? (parseFloat(muscleChange) > 0 ? '<span style="color:var(--green)">↑' + muscleChange + 'kg</span>' : parseFloat(muscleChange) < 0 ? '<span style="color:var(--red)">↓' + Math.abs(parseFloat(muscleChange)) + 'kg</span>' : '持平') : '-'}` +
    `<br>睡眠平均 <strong>${avgSleep !== '-' ? avgSleep + ' 分' : '-'}</strong>`;
}

// ===== 概览页动态渲染 =====
function renderOverview() {
  const db = getDB();
  const bs = db.bodyScale;
  const ex = db.exercise;
  const sl = db.sleep;
  const el = document.getElementById('overview-content');
  if (bs.length === 0) {
    el.innerHTML = '<div class="sb"><div class="ic">📊</div><div class="t">暂无数据</div><div class="d">去「录入」页面记录你的第一条体脂秤数据吧</div></div>';
    return;
  }
  const first = bs[0], last = bs[bs.length-1];
  const days = Math.round((new Date(last.date) - new Date(first.date)) / 86400000) || 1;
  const wtChg = (last.weight - first.weight).toFixed(1);
  const bmi = (last.weight / 1.55 / 1.55).toFixed(1);
  const fatMass = last.weight * (last.bodyFat||0) / 100;
  const fatChg = first.fatMass ? (fatMass - first.fatMass).toFixed(1) : '-';
  const muscleChg = first.muscle && last.muscle ? (last.muscle - first.muscle).toFixed(1) : '-';
  const bmr = last.muscle ? (370 + 21.6 * (last.weight - fatMass)).toFixed(0) : '-';
  const wtDelta = parseFloat(wtChg) < 0 ? '↓' + Math.abs(parseFloat(wtChg)) + 'kg' : parseFloat(wtChg) > 0 ? '↑' + wtChg + 'kg' : '持平';

  let html = '';

  // 最新数据卡片
  html += `<div class="card"><div class="ct">📐 最新数据 · ${last.date}（第${bs.length}次测量）</div>
    <div class="stats">
      <div class="stat"><div class="sl">体重</div><div class="sv">${last.weight}<span class="su">kg</span></div><div class="sc ${parseFloat(wtChg)<0?'dn':parseFloat(wtChg)>0?'up':'fl'}">${wtDelta} (${days}天)</div></div>
      <div class="stat"><div class="sl">BMI</div><div class="sv">${bmi}</div><div class="sc ${parseFloat(bmi)>24?'fl':'dn'}">${parseFloat(bmi)>24?'偏高':parseFloat(bmi)>18.5?'正常':'偏低'}</div></div>
      <div class="stat"><div class="sl">体脂率</div><div class="sv">${last.bodyFat||'-'}<span class="su">%</span></div><div class="sc fl">${last.bodyFat?last.bodyFat+'%':'-'}</div></div>
    </div>
    <div class="mcard">
      <div class="mbox"><div class="ml">骨骼肌</div><div class="mv">${last.muscle||'-'}<span class="sc fl" style="font-size:11px">${muscleChg!=='-'?(parseFloat(muscleChg)>0?'↑'+muscleChg:parseFloat(muscleChg)<0?'↓'+Math.abs(parseFloat(muscleChg)):'持平'):'-'}</span></div></div>
      <div class="mbox"><div class="ml">体脂肪</div><div class="mv">${fatMass.toFixed(1)}<span class="sc dn" style="font-size:11px">${fatChg!=='-'?(parseFloat(fatChg)<0?'↓'+Math.abs(parseFloat(fatChg)):'↑'+fatChg):'-'}</span></div></div>
      <div class="mbox"><div class="ml">基础代谢</div><div class="mv">${bmr} kcal</div></div>
      <div class="mbox"><div class="ml">腰臀比</div><div class="mv">${last.whtr||'-'}<span class="sc fl" style="font-size:11px">${last.whtr?last.whtr:'-'}</span></div></div>
    </div></div>`;

  // 趋势 callout
  if (parseFloat(fatChg) <= 0 && fatChg !== '-') {
    html += `<div class="callout green"><div class="ct2">✅ ${days} 天减重成果</div>
      ${first.date} → ${last.date}：<strong>体重${wtDelta}</strong>（${first.weight}→${last.weight}），<strong>体脂肪${fatChg!=='-'?(parseFloat(fatChg)<0?'↓'+Math.abs(parseFloat(fatChg))+'kg':'↑'+fatChg+'kg'):'-'}</strong>。
      减掉的${fatChg !== '-' && parseFloat(fatChg) <= 0 ? '几乎全是脂肪，没有消耗肌肉——这是理想状态' : '方向正确'}。</div>`;
  }

  // 体脂率异常提醒
  const fatVals = bs.filter(r => r.bodyFat).map(r => r.bodyFat);
  if (fatVals.length >= 3) {
    const max = Math.max(...fatVals), min = Math.min(...fatVals);
    if (max - min > 1.5) {
      html += `<div class="callout yellow"><div class="ct2">⚠️ 体脂率波动</div>
        近期体脂率在 ${min}%-${max}% 之间波动（差值 ${(max-min).toFixed(1)}%）。BIA 体脂秤受水分/进食影响，<strong>单次数值波动 ±1-2% 属正常</strong>，看趋势别盯单次。</div>`;
    }
  }

  // 体重曲线
  html += `<div class="card"><div class="ct">⚖️ 体重曲线（${bs.length}次测量）</div><div class="chart" id="wt-chart">`;
  const maxWt = Math.max(...bs.map(r => r.weight));
  const minWt = Math.min(...bs.map(r => r.weight));
  const range = maxWt - minWt || 1;
  bs.forEach((r, i) => {
    const h = 12 + (r.weight - minWt) / range * 60;
    const isCur = i === bs.length - 1;
    html += `<div class="cb"><div class="cff ${isCur?'cur':''}" style="height:${h}px"></div><div class="cv">${r.weight}</div><div class="cl">${fmtDate(r.date)}</div></div>`;
  });
  html += `</div><div class="ce" style="height:2px;background:var(--dim);margin:4px 0"></div>
    <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--dim)"><span>${first.weight}kg（起点）</span><span>目标: ?</span></div></div>`;

  // 骨骼肌曲线
  if (bs.some(r => r.muscle)) {
    html += `<div class="card"><div class="ct">🦴 骨骼肌变化（关键！）</div><div class="chart">`;
    const maxMus = Math.max(...bs.filter(r => r.muscle).map(r => r.muscle));
    const minMus = Math.min(...bs.filter(r => r.muscle).map(r => r.muscle));
    const musRange = maxMus - minMus || 1;
    bs.forEach((r, i) => {
      const h = r.muscle ? 20 + (r.muscle - minMus) / musRange * 55 : 3;
      const isCur = i === bs.length - 1;
      const isLow = r.muscle && r.muscle <= minMus + musRange * 0.3;
      html += `<div class="cb"><div class="cff ${isCur?'cur':''}" style="height:${h}px;background:${isLow?'var(--red)':isCur?'var(--green)':'var(--purple)'}"></div><div class="cv">${r.muscle||'-'}</div><div class="cl">${fmtDate(r.date)}</div></div>`;
    });
    html += `</div></div>`;
  }

  // 数据摘要
  const slScored2 = sl.filter(r => r.score != null);
  const avgSleep = slScored2.length > 0 ? (slScored2.reduce((s,r)=>s+r.score,0)/slScored2.length).toFixed(0) : '-';
  const recentEx = ex.filter(r => {
    const d = new Date(r.date);
    const now = new Date();
    return (now - d) / 86400000 <= 7;
  }).length;
  html += `<div class="callout blue"><div class="ct2">💡 数据摘要</div>
    ${bs.length} 次测量 · ${days} 天 · ${ex.length} 次运动 · 近7天运动 ${recentEx} 次 · 睡眠平均 ${avgSleep} 分</div>`;

  el.innerHTML = html;
}

// ===== 报告页动态渲染 =====
function renderReport() {
  const db = getDB();
  const bs = db.bodyScale;
  const ex = db.exercise;
  const sl = db.sleep;
  const el = document.getElementById('report-content');
  if (bs.length === 0) {
    el.innerHTML = '<div class="sb"><div class="ic">📋</div><div class="t">暂无报告</div><div class="d">先录入一些数据，报告会自动生成</div></div>';
    return;
  }
  const first = bs[0], last = bs[bs.length-1];
  const days = Math.round((new Date(last.date) - new Date(first.date)) / 86400000) || 1;
  const wtChg = (last.weight - first.weight).toFixed(1);
  const fatMass = last.weight * (last.bodyFat||0) / 100;
  const firstFat = first.fatMass || (first.weight * (first.bodyFat||0) / 100);
  const fatChg = firstFat ? (fatMass - firstFat).toFixed(1) : '-';
  const muscleChg = first.muscle && last.muscle ? (last.muscle - first.muscle).toFixed(1) : '-';
  const whtrChg = first.whtr && last.whtr ? (last.whtr - first.whtr).toFixed(2) : '-';
  const bmr = last.muscle ? (370 + 21.6 * (last.weight - fatMass)).toFixed(0) : '-';
  const recentEx = ex.filter(r => (new Date() - new Date(r.date)) / 86400000 <= 7).length;
  const slScored3 = sl.filter(r => r.score != null);
  const avgSleep = slScored3.length > 0 ? (slScored3.reduce((s,r)=>s+r.score,0)/slScored3.length).toFixed(1) : '-';
  // HRV和心率统计（近7天）
  const recentExRecs = ex.filter(r => (new Date() - new Date(r.date)) / 86400000 <= 7);
  const hrvVals = recentExRecs.filter(r => r.hrv).map(r => r.hrv);
  // 每次训练心率（hr 字段），取近7天运动记录的平均值
  const hrVals = recentExRecs.filter(r => r.hr).map(r => r.hr);
  const restingHrVals = recentExRecs.filter(r => r.restingHr).map(r => r.restingHr);
  const rptAvgHrv = hrvVals.length > 0 ? Math.round(hrvVals.reduce((s,v)=>s+v,0)/hrvVals.length) : null;
  const rptAvgHr = hrVals.length > 0 ? Math.round(hrVals.reduce((s,v)=>s+v,0)/hrVals.length) : null;
  const rptRestingHr = restingHrVals.length > 0 ? Math.round(restingHrVals.reduce((s,v)=>s+v,0)/restingHrVals.length) : null;

  const wtDir = parseFloat(wtChg) < 0 ? 'dn' : parseFloat(wtChg) > 0 ? 'up' : 'fl';
  const fatDir = parseFloat(fatChg) < 0 ? 'dn' : parseFloat(fatChg) > 0 ? 'up' : 'fl';
  const musDir = parseFloat(muscleChg) > 0 ? 'dn' : parseFloat(muscleChg) < 0 ? 'up' : 'fl';
  const whtrDir = parseFloat(whtrChg) < 0 ? 'dn' : parseFloat(whtrChg) > 0 ? 'up' : 'fl';

  let html = '';

  // 汇总表
  html += `<div class="card"><div class="ct">📋 ${days}天数据汇总（${first.date}-${last.date}）</div>
    <div class="rd">
      <div class="rr"><span class="l">体脂秤测量次数</span><span class="v">${bs.length} 次</span></div>
      <div class="rr"><span class="l">体重变化</span><span class="v ${wtDir}">${first.weight} → ${last.weight}kg（${wtChg!=='0'?'↓':''}${Math.abs(parseFloat(wtChg))}kg）</span></div>
      <div class="rr"><span class="l">体脂肪变化</span><span class="v ${fatDir}">${firstFat.toFixed(1)} → ${fatMass.toFixed(1)}kg（${fatChg!=='-'?(parseFloat(fatChg)<0?'↓'+Math.abs(parseFloat(fatChg)):parseFloat(fatChg)>0?'↑'+fatChg:'持平'):'-'}）</span></div>
      <div class="rr"><span class="l">骨骼肌变化</span><span class="v ${musDir}">${first.muscle||'-'} → ${last.muscle||'-'}kg（${muscleChg!=='-'?(parseFloat(muscleChg)>0?'↑'+muscleChg:parseFloat(muscleChg)<0?'↓'+Math.abs(parseFloat(muscleChg)):'持平'):'-'}）</span></div>
      <div class="rr"><span class="l">腰臀比变化</span><span class="v ${whtrDir}">${first.whtr||'-'} → ${last.whtr||'-'}（${whtrChg!=='-'?(parseFloat(whtrChg)<0?'↓'+Math.abs(parseFloat(whtrChg)):parseFloat(whtrChg)>0?'↑'+whtrChg:'无变化'):'-'}）</span></div>
      <div class="rr"><span class="l">基础代谢</span><span class="v">${bmr} kcal</span></div>
      <div class="rr"><span class="l">近 7 天运动</span><span class="v">${recentEx} 次</span></div>
      <div class="rr"><span class="l">近 7 天睡眠</span><span class="v">${avgSleep} 分平均</span></div>
      ${rptAvgHrv !== null ? `<div class="rr"><span class="l">近 7 天HRV</span><span class="v" style="color:${rptAvgHrv < 30 ? 'var(--red)' : rptAvgHrv > 60 ? 'var(--green)' : 'var(--yellow)'}">${rptAvgHrv}ms${rptAvgHrv < 30 ? ' ↓ 偏低' : rptAvgHrv > 60 ? ' ↑ 良好' : ' → 正常'}</span></div>` : ''}
      ${rptAvgHr !== null ? `<div class="rr"><span class="l">近 7 天运动心率</span><span class="v">${rptAvgHr}bpm</span></div>` : ''}
    </div></div>`;

  // 评分
  const fatScore = Math.min(100, Math.max(0, 50 + (parseFloat(fatChg) !== '-' ? -parseFloat(fatChg) * 50 : 0)));
  const musScore = Math.min(100, Math.max(0, 50 + (parseFloat(muscleChg) !== '-' ? parseFloat(muscleChg) * 50 : 0)));
  const whtrScore = Math.min(100, Math.max(0, 50 - (parseFloat(whtrChg) !== '-' ? Math.abs(parseFloat(whtrChg)) * 500 : 0)));
  const totalScore = Math.round((fatScore + musScore + whtrScore) / 3);
  const scoreColor = totalScore >= 70 ? 'var(--green)' : totalScore >= 50 ? 'var(--yellow)' : 'var(--red)';
  const fColor = fatScore >= 70 ? 'var(--green)' : fatScore >= 50 ? 'var(--yellow)' : 'var(--red)';
  const mColor = musScore >= 70 ? 'var(--green)' : musScore >= 50 ? 'var(--yellow)' : 'var(--red)';
  const wColor = whtrScore >= 70 ? 'var(--green)' : whtrScore >= 50 ? 'var(--yellow)' : 'var(--red)';

  html += `<div class="card"><div class="ct">📊 减重质量评分</div><div class="score">
    <div><div class="num" style="color:${scoreColor}">${totalScore}</div><div class="lb">总体</div><div class="bar" style="width:100px"><div class="bf" style="width:${totalScore}%;background:${scoreColor}"></div></div></div>
    <div><div class="num" style="color:${fColor}">${Math.round(fatScore)}</div><div class="lb">脂肪减少</div><div class="bar" style="width:100px"><div class="bf" style="width:${Math.round(fatScore)}%;background:${fColor}"></div></div></div>
    <div><div class="num" style="color:${mColor}">${Math.round(musScore)}</div><div class="lb">肌肉保持</div><div class="bar" style="width:100px"><div class="bf" style="width:${Math.round(musScore)}%;background:${mColor}"></div></div></div>
    <div><div class="num" style="color:${wColor}">${Math.round(whtrScore)}</div><div class="lb">腰围改善</div><div class="bar" style="width:100px"><div class="bf" style="width:${Math.round(whtrScore)}%;background:${wColor}"></div></div></div>
  </div>
  <div style="font-size:12px;color:var(--muted);text-align:center;margin-top:4px">基于 ${bs.length} 次测量 · ${days} 天 · 减重 ${Math.abs(parseFloat(wtChg))}kg</div></div>`;

  // 脂肪减少callout
  if (parseFloat(fatChg) <= 0 && fatChg !== '-') {
    html += `<div class="callout green"><div class="ct2">✅ 脂肪减少方向正确</div>
      体重降了 ${Math.abs(parseFloat(wtChg))}kg，体脂肪也降了 ${Math.abs(parseFloat(fatChg))}kg——<strong>减掉的几乎全是脂肪，没有消耗肌肉</strong>。这是减重最理想的状态。</div>`;
  }

  // 骨骼肌提醒
  const lowMus = bs.filter(r => r.muscle && r.muscle < (first.muscle || 0) - 0.2);
  if (lowMus.length > 0) {
    html += `<div class="callout yellow"><div class="ct2">⚠️ 骨骼肌波动</div>
      ${lowMus.length} 次测量骨骼肌偏低（最低 ${Math.min(...lowMus.map(r=>r.muscle))}kg）。建议保持每 2-3 天一次力量训练。</div>`;
  }

  // HRV提醒
  if (rptAvgHrv !== null && rptAvgHrv < 30) {
    html += `<div class="callout red"><div class="ct2">🔄 HRV 偏低</div>
      近7天平均 HRV ${rptAvgHrv}ms，低于30ms的参考基线。建议检查睡眠质量、压力水平，适当降低训练强度，优先做主动恢复（散步、拉伸、瑜伽）。</div>`;
  } else if (rptAvgHrv !== null && rptAvgHrv > 60) {
    html += `<div class="callout green"><div class="ct2">💚 HRV 良好</div>
      近7天平均 HRV ${rptAvgHrv}ms，恢复状态良好，自主神经系统有弹性。可以维持正常训练强度。</div>`;
  }

  // 训练建议
  const strEx = ex.filter(r => r.type === '力量');
  const cardioEx = ex.filter(r => r.type === '有氧');
  html += `<div class="callout purple"><div class="ct2">🦴 训练建议</div>
    共 ${ex.length} 次运动（${strEx.length} 次力量 + ${cardioEx.length} 次有氧）。
    ${recentEx === 0 ? '最近 7 天无运动记录，建议恢复训练。' : '频率不错，继续保持。'}
    <strong>建议：每周 3 次力量训练 + 2 次有氧</strong>，重点是下肢和核心（帮助降腰臀比）。</div>`;

  // 睡眠提醒
  const lowSleep = sl.filter(r => r.score < 70);
  if (lowSleep.length > 0) {
    html += `<div class="callout blue"><div class="ct2">🌙 睡眠提醒</div>
      有 ${lowSleep.length} 天睡眠评分低于 70 分。睡眠不足会拖慢减脂、影响肌肉恢复，建议保持 7 小时以上。</div>`;
  }

  // 腰臀比提醒
  if (last.whtr && parseFloat(last.whtr) > 0.85) {
    html += `<div class="callout red"><div class="ct2">⚠️ 腰臀比偏高</div>
      当前 ${last.whtr}${whtrChg !== '-' && parseFloat(whtrChg) === 0 ? '，无改善' : ''}。女性腰臀比 &gt;0.85 有健康风险。<strong>这是当前最大的短板</strong>——需要专门的腰腹训练 + 控制精制碳水。</div>`;
  }

  // 下周建议
  html += `<div class="gc"><div class="gt">🎯 下周最该做的三件事</div>
    <div class="gx"><strong>①</strong> 继续每周测体脂秤 2-3 次<br>
    <strong>②</strong> 每周至少 3 次力量训练（重点下肢+核心）<br>
    <strong>③</strong> 每天保证 7 小时睡眠，腰臀比改善需要时间</div></div>`;

  el.innerHTML = html;
}

// ===== 删除记录 =====
function deleteBodyScale(date) {
  if (!confirm('删除 ' + date + ' 的体脂秤记录？')) return;
  const db = getDB();
  db.bodyScale = db.bodyScale.filter(r => r.date !== date);
  saveDB(db);
  renderHistory();
  renderOverview();
  renderReport();
  showToast('🗑️ 已删除');
}

function deleteExercise(date, name) {
  if (!confirm('删除此条运动记录？')) return;
  const db = getDB();
  const idx = db.exercise.findIndex(r => r.date === date && r.name === name);
  if (idx >= 0) db.exercise.splice(idx, 1);
  saveDB(db);
  renderHistory();
  renderOverview();
  renderReport();
  showToast('🗑️ 已删除');
}

function deleteSleep(date) {
  if (!confirm('删除 ' + date + ' 的睡眠记录？')) return;
  const db = getDB();
  db.sleep = db.sleep.filter(r => r.date !== date);
  saveDB(db);
  renderHistory();
  renderOverview();
  renderReport();
  showToast('🗑️ 已删除');
}

function showToast(msg) {
  const el = document.getElementById('ts');
  if (!el) return;
  el.textContent = msg;
  el.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:var(--green);color:#000;padding:10px 20px;border-radius:10px;font-size:13px;font-weight:600;z-index:999;opacity:1;transition:opacity .4s';
  setTimeout(() => { el.style.opacity = '0'; }, 2000);
}

// ===== AI 运动计划 =====
const AI_KEY_STORAGE = 'bc_agent_deepseek_key';

function getAIKey() {
  return localStorage.getItem(AI_KEY_STORAGE) || '';
}

function saveAIKey() {
  const key = document.getElementById('ai-key').value.trim();
  if (key) localStorage.setItem(AI_KEY_STORAGE, key);
  const vKey = document.getElementById('ai-vision-key')?.value.trim();
  const vUrl = document.getElementById('ai-vision-url')?.value.trim();
  const vModel = document.getElementById('ai-vision-model')?.value.trim();
  if (vKey) localStorage.setItem('ai_vision_key', vKey);
  if (vUrl) localStorage.setItem('ai_vision_url', vUrl);
  if (vModel) localStorage.setItem('ai_vision_model', vModel);
  showToast('✅ 设置已保存');
  closeSettings();
  renderAIPage();
}

function setEnergy(v, btn) {
  document.getElementById('ai-energy').value = v;
  document.querySelectorAll('.en-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

function getSelectedEquip() {
  const checks = document.querySelectorAll('#ai-equip-check input[type=checkbox]:checked');
  return Array.from(checks).map(c => c.value);
}

function buildAISummary() {
  const db = getDB();
  const bs = db.bodyScale, ex = db.exercise, sl = db.sleep;
  if (bs.length === 0) return null;
  const first = bs[0], last = bs[bs.length-1];
  const days = Math.round((new Date(last.date) - new Date(first.date)) / 86400000) || 1;
  const wtChg = (last.weight - first.weight).toFixed(1);
  const fatMass = last.weight * (last.bodyFat||0) / 100;
  const firstFat = first.fatMass || (first.weight * (first.bodyFat||0) / 100);
  const fatChg = firstFat ? (fatMass - firstFat).toFixed(1) : '-';
  const muscleChg = first.muscle && last.muscle ? (last.muscle - first.muscle).toFixed(1) : '-';
  const whtrChg = first.whtr && last.whtr ? (last.whtr - first.whtr).toFixed(2) : '-';
  const bmr = last.muscle ? (370 + 21.6 * (last.weight - fatMass)).toFixed(0) : '-';
  const recentEx = ex.filter(r => (new Date() - new Date(r.date)) / 86400000 <= 7).length;
  const slScored4 = sl.filter(r => r.score != null);
  const avgSleep = slScored4.length > 0 ? (slScored4.reduce((s,r)=>s+r.score,0)/slScored4.length).toFixed(1) : '-';
  const avgHours = sl.length > 0 ? (sl.reduce((s,r)=>s+r.hours,0)/sl.length).toFixed(1) : '-';
  const fatScore = Math.min(100, Math.max(0, 50 + (parseFloat(fatChg) !== '-' ? -parseFloat(fatChg) * 50 : 0)));
  const musScore = Math.min(100, Math.max(0, 50 + (parseFloat(muscleChg) !== '-' ? parseFloat(muscleChg) * 50 : 0)));
  const whtrScore = Math.min(100, Math.max(0, 50 - (parseFloat(whtrChg) !== '-' ? Math.abs(parseFloat(whtrChg)) * 500 : 0)));
  const totalScore = Math.round((fatScore + musScore + whtrScore) / 3);
  const strengthCount = ex.filter(r => r.type === '力量').length;
  const cardioCount = ex.filter(r => r.type === '有氧').length;
  const totalDur = ex.reduce((s, r) => s + (r.dur||0), 0);
  // HRV 和心率统计（近7天）
  const recentExRecs = ex.filter(r => (new Date() - new Date(r.date)) / 86400000 <= 7);
  const hrvVals = recentExRecs.filter(r => r.hrv).map(r => r.hrv);
  const hrVals = recentExRecs.filter(r => r.hr).map(r => r.hr);
  const avgHrv = hrvVals.length > 0 ? Math.round(hrvVals.reduce((s,v)=>s+v,0)/hrvVals.length) : null;
  const avgHr = hrVals.length > 0 ? Math.round(hrVals.reduce((s,v)=>s+v,0)/hrVals.length) : null;
  // 分析最近训练过的身体部位（近7天）
  const recentBP = new Set();
  ex.filter(r => (new Date() - new Date(r.date)) / 86400000 <= 7).forEach(r => {
    if (r.exercises) r.exercises.forEach(e => { if (e.group) recentBP.add(e.group); });
  });
  // 近期训练次数按部位
  const bpCount = {};
  ex.forEach(r => {
    if (r.exercises) r.exercises.forEach(e => {
      if (e.group) bpCount[e.group] = (bpCount[e.group]||0) + 1;
    });
  });
  return {
    days, bsCount: bs.length, exCount: ex.length, slCount: sl.length,
    firstDate: first.date, lastDate: last.date,
    firstWt: first.weight, lastWt: last.weight, wtChg: parseFloat(wtChg),
    firstFat: firstFat.toFixed(1), lastFat: fatMass.toFixed(1), fatChg: parseFloat(fatChg),
    firstMus: first.muscle||'-', lastMus: last.muscle||'-', musChg: parseFloat(muscleChg),
    firstWhtr: first.whtr||'-', lastWhtr: last.whtr||'-', whtrChg: parseFloat(whtrChg),
    bmr, totalScore, fatScore: Math.round(fatScore), musScore: Math.round(musScore), whtrScore: Math.round(whtrScore),
    recentEx, avgSleep, avgHours,
    strengthCount, cardioCount, totalDur,
    recentBP: Array.from(recentBP), bpCount,
    avgHrv, avgHr
  };
}

// 构建可用动作库摘要（按部位分组，仅选中的器械）
function buildExerciseSummary(selectedEquip) {
  const groups = {};
  EXERCISES.forEach(e => {
    if (!selectedEquip.includes(e.equipment)) return;
    if (!groups[e.group]) groups[e.group] = [];
    groups[e.group].push(e);
  });
  const groupNames = { chest:'胸', back:'背', shoulders:'肩', biceps:'二头', triceps:'三头', quads_glutes:'股四/臀', hamstrings_calves:'腘绳/小腿', core:'腰腹核心', cardio:'有氧/HIIT' };
  let text = '';
  for (const [g, exs] of Object.entries(groups)) {
    const compound = [...new Set(exs.filter(e => e.mechanics_type === 'compound').map(e => e.name_cn))];
    const isolation = [...new Set(exs.filter(e => e.mechanics_type !== 'compound').map(e => e.name_cn))];
    text += `- ${groupNames[g]||g}:\n  复合动作: ${compound.slice(0,15).join('、') || '无'}\n  孤立动作: ${isolation.slice(0,15).join('、') || '无'}\n`;
  }
  return text;
}

function buildPlanPrompt(s, equipSummary, cycle, energy, injury, profile) {
  if (!s) return '';
  const p = profile || {};
  const isFemale = p.gender === 'female';
  const useCycle = isFemale && p.useCycle === true && cycle;

  // 月经周期阶段轮转
  const PHASES = {
    menstrual: { name: '月经期', focus: '低强度恢复训练：舒缓有氧、瑜伽、轻量核心。注意：月经期不是不训练，而是降低强度，避免跳跃和倒立即可', intensity: '低' },
    follicular: { name: '卵泡期', focus: '雌激素上升，力量训练最佳窗口，compound动作可加重', intensity: '中高' },
    ovulation: { name: '排卵期', focus: '睾酮短暂峰值，峰值训练窗口，可安排最高强度', intensity: '高' },
    luteal: { name: '黄体期', focus: '代谢升高适合代谢性训练，PMS段降低强度', intensity: '中' }
  };
  const PHASE_ORDER = ['menstrual', 'follicular', 'ovulation', 'luteal'];

  let weekStructure = '';
  if (useCycle) {
    const idx = PHASE_ORDER.indexOf(cycle);
    if (idx >= 0) {
      const weekPhases = [0,1,2,3].map(i => PHASE_ORDER[(idx + i) % 4]);
      weekPhases.forEach((ph, i) => {
        const info = PHASES[ph];
        weekStructure += `第${i+1}周：${info.name}（${info.intensity}强度）\n本周重点：${info.focus}\n`;
      });
    }
  } else {
    const defaultThemes = [
      { theme: '基础适应期', focus: '掌握动作模式，建立训练习惯，组数较少' },
      { theme: '进阶强化期', focus: '逐步增加组数和重量，compound动作加重' },
      { theme: '强度提升期', focus: '达到本周期最高训练量，挑战更大重量或更多组数' },
      { theme: '减载/冲刺周', focus: '减少容量让身体恢复，或选择冲刺新PR' }
    ];
    defaultThemes.forEach((t, i) => {
      weekStructure += `第${i+1}周：${t.theme}\n本周重点：${t.focus}\n`;
    });
  }

  // 基本画像信息
  let profileInfo = '';
  if (p.name) profileInfo += `姓名：${p.name}\n`;
  if (p.gender) profileInfo += `性别：${p.gender === 'male' ? '男' : '女'}\n`;
  if (p.age) profileInfo += `年龄：${p.age}岁\n`;
  if (p.height) profileInfo += `身高：${p.height}cm\n`;
  // BMI from height
  if (p.height && s.lastWt) {
    const bmi = (s.lastWt / ((p.height/100) ** 2)).toFixed(1);
    profileInfo += `当前BMI：${bmi}\n`;
  }

  return `请根据以下信息，为我生成一个**4周渐进式运动计划**。每周3-4天训练，需要体现难度/容量的渐进递增。

【我的基本画像】
${profileInfo || '（未设置，请按通用方案）'}

【我的近期数据】
周期：${s.firstDate} → ${s.lastDate}（${s.days}天，共${s.bsCount}次测量）
体重：${s.firstWt}kg → ${s.lastWt}kg（${s.wtChg < 0 ? '↓' + Math.abs(s.wtChg) : '↑' + s.wtChg}kg）
体脂肪：${s.firstFat}kg → ${s.lastFat}kg（${s.fatChg < 0 ? '↓' + Math.abs(s.fatChg) : s.fatChg > 0 ? '↑' + s.fatChg : '持平'}）
骨骼肌：${s.firstMus}kg → ${s.lastMus}kg（${s.musChg > 0 ? '↑' + s.musChg : s.musChg < 0 ? '↓' + Math.abs(s.musChg) : '持平'}）
腰臀比：${s.firstWhtr} → ${s.lastWhtr}（${s.whtrChg < 0 ? '↓' + Math.abs(s.whtrChg) : s.whtrChg > 0 ? '↑' + s.whtrChg : '持平'}）
减重质量总分：${s.totalScore}（脂肪${s.fatScore}/肌肉${s.musScore}/腰围${s.whtrScore}）
运动：${s.exCount}次（力量${s.strengthCount}、有氧${s.cardioCount}），总计${s.totalDur}分钟
近7天运动${s.recentEx}次，练过的部位：${s.recentBP.length > 0 ? s.recentBP.join('、') : '无记录'}
睡眠：平均${s.avgHours}小时（${s.avgSleep}分）
${s.avgHrv ? `晨起HRV（近7天平均）：${s.avgHrv}ms${s.avgHrv < 30 ? '（偏低，注意恢复）' : s.avgHrv > 60 ? '（良好，恢复充分）' : '（正常范围）'}` : ''}${s.avgHr ? `\n运动心率（近7天每次训练平均）：${s.avgHr}bpm` : ''}

【我的目标】${p.goal || '减重+增肌（减脂同时保住/增加肌肉量）'}

【当前身体状态】
${useCycle ? `当前月经周期阶段：${PHASES[cycle].name}\n` : ''}${isFemale && !useCycle ? '月经周期：未启用周期适配\n' : ''}精力水平：${energy}/5${['','（很低，适合轻量运动）','（偏低）','（正常）','（不错）','（精力旺盛，可以加量）'][energy]}
伤病/不适：${injury || '无'}

【4周结构】（请严格按以下结构生成，每周对应指定阶段）
${weekStructure}

【可用动作库】（仅限我有器械的动作）
${equipSummary}

【输出格式要求】
请严格按以下格式输出，每周一个区块，中间用空行分隔：

第1周：${useCycle ? PHASES[PHASE_ORDER[(PHASE_ORDER.indexOf(cycle)) % 4]].name : '基础适应期'}（${useCycle ? PHASES[PHASE_ORDER[(PHASE_ORDER.indexOf(cycle)) % 4]].intensity + '强度' : '低强度'}）
本周重点：一句话说明本周训练侧重
第1天：主题（如"上肢推+核心"）
推荐理由：一句话
动作列表（每行一个，格式：动作名 - X组×Y次/秒/分钟）
训练提示：一句（可选）
第2天：...
第3天：...
（休息日可不列）
本周进阶点：一句话说明下周如何递进

第2周：...

第3周：...

第4周：...

（必须完整输出4周，不能跳过任何一周，月经期也要有训练计划）

整体建议：2-3句

重要规则：
1. 动作名必须从上面「可用动作库」中选择，不要编造不存在的动作
2. 每周3-4天训练，覆盖不同肌群，避免连续两天练同一部位
3. 每天至少包含1个复合动作（compound），复合动作优先放在前2组
4. 孤立动作（isolation）用于补充训练，放在复合动作之后
5. 注意secondary_muscles关联：如练胸可连带刺激三头，不要同一天安排三头孤立训练
6. 4周必须体现渐进：第1周以基础动作为主、组数较少；第2-3周逐步增加组数或难度；第4周可选择减载（减少容量）或冲刺（增加强度）
7. 根据精力水平调整初始强度，精力低时第1周减少组数
8. ${useCycle ? '严格按上面的月经周期阶段安排训练，必须4周都有训练计划。月经期也要安排训练（低强度有氧、瑜伽、轻量核心），只是避免跳跃和倒立，绝不跳过月经期。卵泡期可加重，排卵期可安排峰值强度，黄体期适合代谢性训练但后半段降低强度' : '如果有伤病，要避开相关部位'}
9. 如果用户有伤病，要避开相关部位
10. 每天总时长控制在30-60分钟之间
11. 每组动作之间建议休息30-90秒（请在动作中标注）
12. 不要用任何Markdown格式标记（不用**、不用#、不用-列表，用纯文本）`;
}

function renderAIPage() {
  applyProfile(); // ensure cycle selector visibility matches gender
  const key = getAIKey();

  const vUrl = document.getElementById('ai-vision-url');
  const vModel = document.getElementById('ai-vision-model');
  if (vUrl) vUrl.value = localStorage.getItem('ai_vision_url') || 'https://1469564893-2azg8ebcd5.ap-guangzhou.tencentscf.com';
  if (vModel) vModel.value = localStorage.getItem('ai_vision_model') || 'sensenova-6.8-flash-lite';
  const vKeyEl = document.getElementById('ai-vision-key');
  if (vKeyEl) vKeyEl.value = localStorage.getItem('ai_vision_key') || '';

  // 显示/隐藏空状态
  const summary = buildAISummary();
  const empty = document.getElementById('ai-empty');
  const stateCard = document.getElementById('ai-state-card');
  if (!summary) {
    if (empty) empty.style.display = 'block';
    if (stateCard) stateCard.style.display = 'none';
    return;
  }
  if (empty) empty.style.display = 'none';
  if (stateCard) stateCard.style.display = 'block';

  // 恢复缓存的计划
  const cachedPlan = localStorage.getItem('bc_ai_plan_cache');
  const planArea = document.getElementById('ai-plan-area');
  const loading = document.getElementById('ai-loading-area');
  const error = document.getElementById('ai-error-area');
  if (loading) loading.style.display = 'none';
  if (error) error.style.display = 'none';
  if (cachedPlan && planArea) {
    renderPlan(cachedPlan);
    document.getElementById('ai-plan-btn').textContent = '🔄 重新生成';
  }

  // 恢复身体状态
  const savedState = JSON.parse(localStorage.getItem('bc_ai_state') || '{}');
  if (savedState.cycle) document.getElementById('ai-cycle').value = savedState.cycle;
  if (savedState.energy) {
    document.getElementById('ai-energy').value = savedState.energy;
    document.querySelectorAll('.en-btn').forEach(b => {
      b.classList.toggle('active', parseInt(b.dataset.en) === savedState.energy);
    });
  }
  if (savedState.injury) document.getElementById('ai-injury').value = savedState.injury || '';
  if (savedState.equip) {
    document.querySelectorAll('#ai-equip-check input[type=checkbox]').forEach(cb => {
      cb.checked = savedState.equip.includes(cb.value);
    });
  }
}

function renderPlan(planText) {
  const area = document.getElementById('ai-plan-area');
  area.style.display = 'block';
  _planExercises = [];

  // 解析AI输出：支持"第N周"和"第N天"两种格式
  const lines = planText.split('\n').filter(l => l.trim());
  const weeks = [];
  let currentWeek = null;
  let currentDay = null;
  let overallTips = [];
  let hasWeeks = false;

  for (const line of lines) {
    // 第N周格式
    const weekMatch = line.match(/^第(\d+)周[：:]\s*(.*)/);
    if (weekMatch) {
      hasWeeks = true;
      if (currentDay && currentWeek) currentWeek.days.push(currentDay);
      if (currentWeek) weeks.push(currentWeek);
      currentWeek = { num: weekMatch[1], theme: weekMatch[2].trim(), focus: '', days: [], progress: '' };
      currentDay = null;
      continue;
    }
    // 第N天格式
    const dayMatch = line.match(/^第(\d+)天[：:]\s*(.*)/);
    if (dayMatch) {
      if (currentDay && currentWeek) currentWeek.days.push(currentDay);
      else if (currentDay && !currentWeek) {
        // 无周结构的旧格式，创建一个虚拟周
        currentWeek = { num: '0', theme: '训练计划', focus: '', days: [currentDay], progress: '' };
        weeks.push(currentWeek);
      }
      currentDay = { num: dayMatch[1], theme: dayMatch[2].trim(), reason: '', actions: [], tips: [] };
      continue;
    }
    if (!currentWeek && !currentDay) {
      overallTips.push(line);
      continue;
    }
    // 周级别字段
    if (currentWeek && !currentDay) {
      if (line.startsWith('本周重点')) {
        currentWeek.focus = line.replace(/^本周重点[：:]\s*/, '');
      } else if (line.startsWith('本周进阶点')) {
        currentWeek.progress = line.replace(/^本周进阶点[：:]\s*/, '');
      } else if (line.startsWith('整体建议')) {
        overallTips.push(line);
      } else {
        overallTips.push(line);
      }
      continue;
    }
    // 天级别字段
    if (currentDay) {
      if (line.startsWith('推荐理由')) {
        currentDay.reason = line.replace(/^推荐理由[：:]\s*/, '');
      } else if (line.startsWith('训练提示')) {
        currentDay.tips.push(line.replace(/^训练提示[：:]\s*/, ''));
      } else if (line.startsWith('动作列表')) {
        // skip heading
      } else if (line.match(/^[\u4e00-\u9fa5a-zA-Z]/)) {
        currentDay.actions.push(line);
      } else {
        currentDay.tips.push(line);
      }
    }
  }
  // 收尾
  if (currentDay && currentWeek) currentWeek.days.push(currentDay);
  else if (currentDay && !currentWeek) {
    currentWeek = { num: '0', theme: '训练计划', focus: '', days: [currentDay], progress: '' };
    weeks.push(currentWeek);
  }
  if (currentWeek && !hasWeeks && weeks.length === 0) weeks.push(currentWeek);

  const weekColors = ['#5B9FE0', '#4CAF50', '#FF9800', '#E91E63'];
  let html = '';

  // 未完成会话提示
  const unfinished = checkUnfinishedSession();
  if (unfinished) {
    html += `<div class="wp-session-banner">
      <div><div style="font-size:13px;font-weight:600">📋 继续上次训练</div>
      <div style="font-size:11px;color:var(--muted)">已完成 ${unfinished.doneCount}/${unfinished.session.exercises.length} 个动作</div></div>
      <button class="wp-btn wp-btn-pri wp-btn-sm" onclick="resumeSession()">继续</button>
    </div>`;
  }

  for (let wi = 0; wi < weeks.length; wi++) {
    const w = weeks[wi];
    const color = weekColors[wi % weekColors.length];
    html += `<div class="plan-week" style="border:2px solid ${color};border-radius:12px;padding:12px;margin-bottom:12px">`;
    html += `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid ${color}33">
      <span style="font-weight:700;font-size:15px;color:${color}">📅 第${w.num}周：${w.theme}</span>
    </div>`;
    if (w.focus) {
      html += `<div style="font-size:12px;color:var(--muted);margin-bottom:8px">🎯 ${w.focus}</div>`;
    }
    for (const day of w.days) {
      html += `<div class="plan-day" style="border-color:${color}66;border-left:3px solid ${color}">
        <div class="plan-day-hd">
          <span>第${day.num}天：${day.theme}</span>
          ${day.reason ? `<span class="focus">${day.reason}</span>` : ''}
        </div>`;
      day.actions.forEach((a, i) => {
        const parsed = parseActionLine(a);
        const exIdx = _planExercises.length;
        _planExercises.push({ ...parsed, dayRef: `第${day.num}天:${day.theme}`, raw: a });
        const gifUrl = findExerciseGif(parsed.name);
        const gifIcon = gifUrl ? '<span style="font-size:11px;color:var(--dim);margin-left:4px">🎬</span>' : '';
        const gifClick = gifUrl ? `onclick="showExerciseGif('${parsed.name.replace(/'/g, "\\'")}');event.stopPropagation()"` : '';
        const gifStyle = gifUrl ? 'cursor:pointer' : '';
        const doneMark = isExerciseDoneToday(parsed.name);
        const detailParts = a.split(/[-–—]/).map(s => s.trim());
        const detailText = detailParts.length >= 2 ? detailParts.slice(1).join(' - ') : '';
        html += `<div class="plan-item" style="position:relative">
            <div class="idx">${i+1}</div>
            <div class="info" ${gifClick ? gifClick : ''} style="${gifStyle};flex:1;min-width:0">
              <div class="nm">${parsed.name}${gifIcon}${doneMark ? ' <span style="color:var(--green);font-size:11px">✓</span>' : ''}</div>
              ${detailText ? `<div class="detail">${detailText}</div>` : ''}
            </div>
            <button class="wp-play-btn" onclick="event.stopPropagation();startWorkout(${exIdx})">▶</button>
          </div>`;
      });
      if (day.tips.length > 0) {
        html += `<div class="plan-note">💡 ${day.tips.join('；')}</div>`;
      }
      html += `</div>`;
    }
    if (w.progress) {
      html += `<div style="font-size:12px;color:${color};margin-top:6px;padding:6px 10px;background:${color}11;border-radius:6px">📈 ${w.progress}</div>`;
    }
    html += `</div>`;
  }

  if (overallTips.length > 0) {
    html += `<div class="card" style="border-color:var(--green);">
      <div class="ct" style="color:var(--green)">📌 整体建议</div>
      <div style="font-size:13px;line-height:1.7;word-break:break-word;color:var(--muted)">${overallTips.map(t => t.replace(/^整体建议[：:]\s*/, '')).join('<br>')}</div>
    </div>`;
  }

  html += `<button class="sub" onclick="runAIPlan()" style="margin-top:6px;background:var(--card);color:var(--text);border:1px solid var(--border)">🔄 重新生成</button>`;
  area.innerHTML = html;
}

async function runAIPlan() {
  const key = getAIKey();
  if (!key) { showToast('请先设置 API Key'); return; }
  const summary = buildAISummary();
  if (!summary) { showToast('请先录入体脂秤数据'); return; }

  const cycle = document.getElementById('ai-cycle').value;
  const energy = parseInt(document.getElementById('ai-energy').value) || 3;
  const injury = document.getElementById('ai-injury').value.trim();
  const equip = getSelectedEquip();
  if (equip.length === 0) { showToast('请至少选一种器械'); return; }

  // 保存身体状态
  localStorage.setItem('bc_ai_state', JSON.stringify({ cycle, energy, injury, equip }));
  scheduleCloudSync();

  const btn = document.getElementById('ai-plan-btn');
  const loading = document.getElementById('ai-loading-area');
  const error = document.getElementById('ai-error-area');
  const planArea = document.getElementById('ai-plan-area');

  btn.style.display = 'none';
  loading.style.display = 'block';
  error.style.display = 'none';
  planArea.style.display = 'none';

  const equipSummary = buildExerciseSummary(equip);

  try {
    const profile = getProfile();
    const resp = await fetch('https://api.deepseek.com/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + key },
      body: JSON.stringify({
        model: 'deepseek-chat',
        messages: [
          { role: 'system', content: `你是一个专业的健身教练，擅长根据用户身体数据、目标和当前状态制定个性化运动计划。${profile.gender === 'female' ? '你精通月经周期训练适配：月经期以低强度恢复为主、卵泡期是力量训练最佳窗口、排卵期可安排峰值强度、黄体期适合代谢性训练但PMS段降低强度。' : ''}你精通训练动作分类学：复合动作（compound，如深蹲、硬拉、卧推、推举）多关节协同、适合放在训练前段；孤立动作（isolation，如弯举、飞鸟、侧平举）单关节、适合补充刺激。你会利用动作的secondary_muscles信息来避免同一肌群被重复过度训练（如练胸已带三头刺激，当天就不再安排三头孤立动作）。你的计划总是具体、可执行。` },
          { role: 'user', content: buildPlanPrompt(summary, equipSummary, cycle, energy, injury, profile) }
        ],
        temperature: 0.7,
        max_tokens: 4000
      })
    });
    const data = await resp.json();
    if (data.error) throw new Error(data.error.message || 'API 请求失败');
    const text = data.choices[0].message.content.trim();

    // 缓存
    localStorage.setItem('bc_ai_plan_cache', text);
    localStorage.setItem('bc_ai_plan_cache_time', new Date().toISOString());
    scheduleCloudSync();

    renderPlan(text);
    loading.style.display = 'none';
    btn.style.display = 'block';
    btn.textContent = '🔄 重新生成';
    showToast('✅ 计划已生成');
  } catch (e) {
    loading.style.display = 'none';
    btn.style.display = 'block';
    error.style.display = 'block';
    error.textContent = '❌ ' + (e.message || '生成失败，请检查 API Key 和网络');
  }
}

// ===== 训练播放器 =====
let _planExercises = [];
let _workoutState = null;
let _restTimer = null;
let _cardioTimer = null;
let _cardioStart = 0;

// 解析动作行文本 → 结构化数据
function parseActionLine(line) {
  const r = { name:'', type:'strength', sets:0, reps:'', rest:90, targetDuration:0, targetHR:'', freeMode:false, raw:line };
  const parts = line.split(/[-–—]/).map(s => s.trim());
  r.name = parts[0];
  const txt = line;
  // 类型检测
  const cardioKW = ['步行','跑步','慢跑','快走','骑行','骑车','游泳','跳绳','踏步','划船','椭圆','有氧','登山','散步','台阶'];
  const stretchKW = ['拉伸','热身','放松','泡沫轴','动态拉伸','静态拉伸','伸展'];
  if (cardioKW.some(k => r.name.includes(k) || txt.includes(k))) r.type = 'cardio';
  else if (stretchKW.some(k => r.name.includes(k) || txt.includes(k))) r.type = 'stretch';
  // 组数×次数
  const sm = txt.match(/(\d+)\s*组?\s*[×xX*]\s*(\d+)(?:\s*[-–~]\s*(\d+))?\s*次?/);
  if (sm) { r.sets = parseInt(sm[1]); r.reps = sm[3] ? `${sm[2]}-${sm[3]}` : sm[2]; }
  // 休息
  const rm = txt.match(/(?:组间)?休息\s*(\d+)\s*秒/);
  if (rm) r.rest = parseInt(rm[1]);
  // 时长
  const dm = txt.match(/(\d+)\s*(?:分钟|min)/);
  if (dm) r.targetDuration = parseInt(dm[1]);
  // 心率
  const hr = txt.match(/心率\s*(\d+)\s*[-–~]\s*(\d+)/);
  if (hr) r.targetHR = `${hr[1]}-${hr[2]}`;
  else { const h1 = txt.match(/心率\s*(\d+)/); if (h1) r.targetHR = h1[1]; }
  // 力量未解析出组数 → 自由模式
  if (r.sets === 0 && r.type === 'strength') r.freeMode = true;
  return r;
}

function isExerciseDoneToday(name) {
  const today = new Date().toISOString().slice(0,10);
  const ss = JSON.parse(localStorage.getItem('bc_workout_sessions') || '[]');
  const s = ss.find(s => s.date === today && !s.completed);
  return s ? s.exercises.some(e => e.name === name && e.completed) : false;
}

function getLastWeight(name) {
  const ss = JSON.parse(localStorage.getItem('bc_workout_sessions') || '[]');
  for (let i = ss.length-1; i >= 0; i--) {
    const ex = ss[i].exercises.find(e => e.name === name && e.sets && e.sets.length > 0);
    if (ex) return ex.sets[ex.sets.length-1].weight || null;
  }
  return null;
}

function getOrCreateTodaySession() {
  const today = new Date().toISOString().slice(0,10);
  const ss = JSON.parse(localStorage.getItem('bc_workout_sessions') || '[]');
  let s = ss.find(s => s.date === today && !s.completed);
  if (!s) {
    s = { date:today, startTime:new Date().toTimeString().slice(0,5), endTime:'', exercises:[], totalDuration:0, avgHR:null, completed:false };
    ss.push(s);
    localStorage.setItem('bc_workout_sessions', JSON.stringify(ss));
    scheduleCloudSync();
  }
  return s;
}

function saveWorkoutSession(session) {
  const ss = JSON.parse(localStorage.getItem('bc_workout_sessions') || '[]');
  const idx = ss.findIndex(s => s.date === session.date && s.startTime === session.startTime);
  if (idx >= 0) ss[idx] = session; else ss.push(session);
  localStorage.setItem('bc_workout_sessions', JSON.stringify(ss));
  scheduleCloudSync();
}

function getWorkoutSessions() {
  return JSON.parse(localStorage.getItem('bc_workout_sessions') || '[]');
}

function checkUnfinishedSession() {
  const ss = getWorkoutSessions();
  const today = new Date().toISOString().slice(0,10);
  const s = ss.find(s => s.date === today && !s.completed && s.exercises.length > 0);
  return s ? { session:s, doneCount:s.exercises.filter(e => e.completed).length } : null;
}

function resumeSession() {
  const chk = checkUnfinishedSession();
  if (!chk) return;
  const next = chk.session.exercises.find(e => !e.completed);
  if (next) {
    _workoutState = { session:chk.session, exercise:next, exIdx:-1 };
    renderWorkoutPlayer();
    document.getElementById('workout-player').style.display = 'flex';
  } else {
    showToast('所有动作已完成');
  }
}

// ===== 打开播放器 =====
function startWorkout(exIdx) {
  const exData = _planExercises[exIdx];
  if (!exData) return;
  const session = getOrCreateTodaySession();
  let ex = session.exercises.find(e => e.name === exData.name && !e.completed);
  if (!ex) {
    ex = {
      name:exData.name, gifUrl:findExerciseGif(exData.name), type:exData.type,
      targetSets:exData.sets, targetReps:exData.reps, targetDuration:exData.targetDuration,
      targetHR:exData.targetHR, rest:exData.rest, freeMode:exData.freeMode,
      sets:[], actualDuration:0, actualHR:null, completed:false, exStartTime:Date.now()
    };
    session.exercises.push(ex);
    saveWorkoutSession(session);
  }
  _workoutState = { session, exercise:ex, exIdx };
  renderWorkoutPlayer();
  document.getElementById('workout-player').style.display = 'flex';
}

// ===== 渲染播放器 =====
function renderWorkoutPlayer() {
  const ex = _workoutState.exercise;
  const info = findExerciseInfo(ex.name);
  const cnName = info ? info.name_cn : ex.name;
  const gifUrl = ex.gifUrl || (info && info.gif_url ? GIF_BASE + info.gif_url : '');
  document.getElementById('wp-title').textContent = cnName;
  const doneSets = ex.sets.filter(s => s.done).length;
  document.getElementById('wp-progress').textContent = ex.freeMode ? `${ex.sets.length}组` : `${doneSets}/${ex.targetSets||0}组`;

  let html = '';
  if (gifUrl) html += `<img src="${gifUrl}" class="wp-gif" onerror="this.style.display='none'"/>`;
  html += `<div class="wp-target-box"><div style="font-size:15px;font-weight:700">${cnName}</div>`;
  if (ex.type === 'cardio' || ex.type === 'stretch') {
    if (ex.targetDuration) html += `<div style="font-size:12px;color:var(--muted);margin-top:4px">🎯 目标时长：${ex.targetDuration}分钟</div>`;
    if (ex.targetHR) html += `<div style="font-size:12px;color:var(--muted)">❤️ 目标心率：${ex.targetHR} bpm</div>`;
  } else {
    if (!ex.freeMode && ex.targetSets) html += `<div style="font-size:12px;color:var(--muted);margin-top:4px">🎯 目标：${ex.targetSets}组 × ${ex.targetReps}次 · 休息${ex.rest}秒</div>`;
    if (ex.freeMode) html += `<div style="font-size:12px;color:var(--muted);margin-top:4px">📝 自由记录模式</div>`;
    const lw = getLastWeight(ex.name);
    if (lw) html += `<div style="font-size:11px;color:var(--dim);margin-top:2px">📊 上次重量：${lw}kg</div>`;
    else html += `<div style="font-size:11px;color:var(--dim);margin-top:2px">💡 首次记录，请输入重量</div>`;
  }
  html += `</div>`;
  if (ex.type === 'cardio' || ex.type === 'stretch') html += renderCardioPlayer(ex);
  else html += renderStrengthPlayer(ex);
  document.getElementById('wp-content').innerHTML = html;
  renderWorkoutBottom();
}

// ===== 力量训练渲染 =====
function renderStrengthPlayer(ex) {
  let html = '';
  // 进度点
  if (!ex.freeMode && ex.targetSets > 0) {
    html += `<div class="wp-dots">`;
    for (let i = 0; i < ex.targetSets; i++) {
      const dn = ex.sets.filter(s => s.done).length;
      const cls = i < dn ? 'done' : (i === dn ? 'active' : '');
      html += `<div class="wp-dot ${cls}"></div>`;
    }
    html += `</div>`;
  }
  // 已完成组列表
  if (ex.sets.length > 0) {
    html += `<div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:10px;margin-bottom:12px">`;
    ex.sets.forEach((s, i) => {
      html += `<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;${i < ex.sets.length-1 ? 'border-bottom:1px solid var(--border)' : ''}">
        <span style="font-size:13px;color:var(--muted)">第${i+1}组</span>
        <span style="font-size:14px;font-weight:600">${s.weight}kg × ${s.reps}次</span>
        ${s.done ? '<span style="color:var(--green)">✓</span>' : ''}
      </div>`;
    });
    html += `</div>`;
  }
  // 当前组输入
  const dn = ex.sets.filter(s => s.done).length;
  const allDone = !ex.freeMode && dn >= ex.targetSets;
  if (!allDone) {
    const setNum = dn + 1;
    const lastSet = ex.sets.length > 0 ? ex.sets[ex.sets.length-1] : null;
    const preW = lastSet ? lastSet.weight : (getLastWeight(ex.name) || '');
    const preR = ex.targetReps ? ex.targetReps.split('-')[0] : (lastSet ? lastSet.reps : '');
    html += `<div style="background:var(--card);border:1px solid var(--accent);border-radius:12px;padding:16px">
      <div style="text-align:center;font-size:14px;font-weight:600;margin-bottom:12px">第${setNum}组${ex.freeMode ? '' : ' · 目标 ' + ex.targetReps + '次'}</div>
      <div class="wp-set-form">
        <div><div class="wp-input-label">重量(kg)</div><input type="number" id="wp-weight" class="wp-input" placeholder="0" value="${preW}" inputmode="decimal" step="2.5"></div>
        <div><div class="wp-input-label">次数</div><input type="number" id="wp-reps" class="wp-input" placeholder="0" value="${preR}" inputmode="numeric"></div>
      </div>
      <button class="wp-btn wp-btn-pri" style="width:100%;margin-top:12px" onclick="completeSet()">✓ 完成本组</button>
    </div>`;
  } else {
    html += `<div style="text-align:center;padding:20px"><div style="font-size:32px;margin-bottom:8px">🎉</div><div style="font-size:15px;font-weight:600">全部 ${ex.targetSets} 组完成！</div></div>`;
  }
  return html;
}

// ===== 有氧训练渲染 =====
function renderCardioPlayer(ex) {
  let html = '';
  const elapsed = ex.actualDuration || 0;
  const mins = Math.floor(elapsed / 60);
  const secs = elapsed % 60;
  html += `<div style="text-align:center;padding:10px 0"><div class="wp-timer-big" id="cardio-timer">${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}</div>`;
  if (ex.targetDuration > 0) {
    const pct = Math.min(100, (elapsed / (ex.targetDuration*60)) * 100);
    const col = pct >= 100 ? 'var(--green)' : 'var(--accent)';
    html += `<div class="wp-prog-bar"><div class="wp-prog-fill" style="width:${pct}%;background:${col}"></div></div>`;
    html += `<div style="font-size:12px;color:var(--muted)">${elapsed}/${ex.targetDuration*60}秒</div>`;
  }
  html += `</div>`;
  // 心率输入
  html += `<div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px;margin:12px 0">
    <div class="wp-input-label" style="margin-bottom:6px">❤️ 当前心率 (bpm)</div>
    <input type="number" id="wp-cardio-hr" class="wp-input" style="width:100%;font-size:20px" placeholder="0" value="${ex.actualHR||''}" inputmode="numeric">
  </div>`;
  const running = _cardioTimer !== null;
  html += `<div style="display:flex;gap:8px">
    <button class="wp-btn ${running?'wp-btn-gh':'wp-btn-pri'}" style="flex:1" onclick="${running?'pauseCardio()':'startCardio()'}">${running?'⏸ 暂停':'▶ 开始'}</button>
    <button class="wp-btn wp-btn-gh" style="flex:1" onclick="endCardio()">⏹ 结束</button>
  </div>`;
  return html;
}

// ===== 底部操作栏 =====
function renderWorkoutBottom() {
  const ex = _workoutState.exercise;
  const bt = document.getElementById('wp-bottom');
  if (ex.type === 'cardio' || ex.type === 'stretch') {
    bt.innerHTML = `<button class="wp-btn wp-btn-gh" style="width:100%" onclick="closeWorkoutPlayer()">← 返回计划</button>`;
    return;
  }
  const dn = ex.sets.filter(s => s.done).length;
  const allDone = !ex.freeMode && dn >= ex.targetSets;
  if (allDone || (ex.freeMode && ex.sets.length > 0)) {
    bt.innerHTML = `<button class="wp-btn wp-btn-pri" style="width:100%" onclick="completeExercise()">✓ 完成动作</button>`;
  } else {
    bt.innerHTML = `<button class="wp-btn wp-btn-gh" style="width:100%" onclick="closeWorkoutPlayer()">← 返回计划</button>`;
  }
}

// ===== 完成一组（力量） =====
function completeSet() {
  const ex = _workoutState.exercise;
  const w = parseFloat(document.getElementById('wp-weight').value) || 0;
  const r = parseInt(document.getElementById('wp-reps').value) || 0;
  if (r === 0) { showToast('请输入次数'); return; }
  ex.sets.push({ weight:w, reps:r, rest:ex.rest, done:true });
  saveWorkoutSession(_workoutState.session);
  const dn = ex.sets.filter(s => s.done).length;
  const allDone = !ex.freeMode && dn >= ex.targetSets;
  if (!allDone && ex.rest > 0) showRestTimer(ex.rest);
  else { renderWorkoutPlayer(); document.getElementById('wp-content').scrollTop = 99999; }
}

// ===== 休息计时器 =====
function showRestTimer(seconds) {
  const old = document.getElementById('rest-overlay');
  if (old) old.remove();
  if (_restTimer) { clearInterval(_restTimer); _restTimer = null; }
  const ov = document.createElement('div');
  ov.id = 'rest-overlay';
  ov.className = 'wp-rest-box';
  let rem = seconds;
  const orig = seconds;
  ov.innerHTML = `
    <div style="font-size:14px;color:var(--muted);margin-bottom:8px">⏱ 组间休息</div>
    <div class="wp-rest-time" id="rest-cd">${rem}</div>
    <div class="wp-rest-bar"><div class="wp-rest-fill" id="rest-fill" style="width:100%;background:var(--accent)"></div></div>
    <div style="display:flex;gap:10px;margin-top:20px">
      <button class="wp-btn wp-btn-gh wp-btn-sm" onclick="adjustRest(-15)">-15s</button>
      <button class="wp-btn wp-btn-pri wp-btn-sm" onclick="skipRest()">跳过</button>
      <button class="wp-btn wp-btn-gh wp-btn-sm" onclick="adjustRest(15)">+15s</button>
    </div>`;
  document.body.appendChild(ov);
  _restTimer = setInterval(() => {
    rem--;
    const cd = document.getElementById('rest-cd');
    const fl = document.getElementById('rest-fill');
    if (cd) cd.textContent = rem;
    if (fl) { fl.style.width = Math.max(0, (rem/orig)*100) + '%'; fl.style.background = rem <= 10 ? 'var(--red)' : 'var(--accent)'; }
    if (rem <= 0) { beep(); skipRest(); }
  }, 1000);
}

function adjustRest(delta) {
  if (_restTimer) { clearInterval(_restTimer); _restTimer = null; }
  const cd = document.getElementById('rest-cd');
  if (!cd) return;
  let cur = parseInt(cd.textContent) + delta;
  if (cur < 0) cur = 0;
  showRestTimer(cur);
}

function skipRest() {
  if (_restTimer) { clearInterval(_restTimer); _restTimer = null; }
  const ov = document.getElementById('rest-overlay');
  if (ov) ov.remove();
  renderWorkoutPlayer();
  document.getElementById('wp-content').scrollTop = 99999;
}

function beep() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    [800, 1000, 800].forEach((f, i) => {
      const o = ctx.createOscillator(); const g = ctx.createGain();
      o.connect(g); g.connect(ctx.destination);
      o.frequency.value = f; g.gain.value = 0.25;
      o.start(ctx.currentTime + i * 0.15); o.stop(ctx.currentTime + i * 0.15 + 0.1);
    });
  } catch(e) {}
}

// ===== 有氧计时 =====
function startCardio() {
  const ex = _workoutState.exercise;
  _cardioStart = Date.now() - (ex.actualDuration || 0) * 1000;
  _cardioTimer = setInterval(() => {
    const el = Math.floor((Date.now() - _cardioStart) / 1000);
    ex.actualDuration = el;
    const t = document.getElementById('cardio-timer');
    if (t) { const m = Math.floor(el/60), s = el%60; t.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`; }
    if (ex.targetDuration > 0) {
      const pct = Math.min(100, (el/(ex.targetDuration*60))*100);
      const fl = document.querySelector('.wp-prog-fill');
      if (fl) { fl.style.width = pct+'%'; fl.style.background = pct>=100 ? 'var(--green)' : 'var(--accent)'; }
      if (el === ex.targetDuration*60) { beep(); showToast('🎯 目标时长已达！'); }
    }
  }, 1000);
  renderWorkoutPlayer();
}

function pauseCardio() {
  if (_cardioTimer) { clearInterval(_cardioTimer); _cardioTimer = null; }
  const hrEl = document.getElementById('wp-cardio-hr');
  if (hrEl) _workoutState.exercise.actualHR = parseInt(hrEl.value) || null;
  renderWorkoutPlayer();
}

function endCardio() {
  const ex = _workoutState.exercise;
  if (_cardioTimer) { clearInterval(_cardioTimer); _cardioTimer = null; }
  const hrEl = document.getElementById('wp-cardio-hr');
  if (hrEl) ex.actualHR = parseInt(hrEl.value) || null;
  if (!ex.actualDuration || ex.actualDuration === 0) { showToast('请先开始计时'); return; }
  ex.actualDuration = Math.round(ex.actualDuration / 60 * 10) / 10;
  ex.completed = true;
  saveWorkoutSession(_workoutState.session);
  showExerciseCompletePrompt();
}

// ===== 完成动作（力量） =====
function completeExercise() {
  _workoutState.exercise.completed = true;
  showExerciseCompletePrompt();
}

function showExerciseCompletePrompt() {
  const ex = _workoutState.exercise;
  const old = document.getElementById('ex-complete-overlay');
  if (old) old.remove();
  let sum = '';
  if (ex.type === 'strength') {
    const tot = ex.sets.reduce((s,x) => s + x.reps, 0);
    const mx = ex.sets.length > 0 ? Math.max(...ex.sets.map(s => s.weight)) : 0;
    sum = `<div style="font-size:13px;color:var(--muted);margin-bottom:4px">完成 ${ex.sets.length} 组</div>
      <div style="font-size:16px;font-weight:700">${tot} 次总举量</div>
      <div style="font-size:13px;color:var(--accent);margin-top:4px">最高 ${mx}kg</div>`;
  } else {
    sum = `<div style="font-size:13px;color:var(--muted);margin-bottom:4px">${ex.type==='cardio'?'有氧':'拉伸'}完成</div>
      <div style="font-size:16px;font-weight:700">${ex.actualDuration} 分钟</div>`;
  }
  const ov = document.createElement('div');
  ov.id = 'ex-complete-overlay';
  ov.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(15,23,42,.9);display:flex;align-items:center;justify-content:center;padding:20px';
  ov.innerHTML = `
    <div style="background:var(--card);border-radius:16px;width:100%;max-width:360px;padding:24px;text-align:center">
      <div style="font-size:40px;margin-bottom:8px">🎉</div>
      <div style="font-size:17px;font-weight:700;margin-bottom:12px">${ex.name}</div>
      ${sum}
      <div style="margin-top:16px">
        <div class="wp-input-label">❤️ 平均心率 (可选)</div>
        <input type="number" id="ex-complete-hr" class="wp-input" style="width:120px;margin:6px auto" placeholder="0" inputmode="numeric" value="${ex.actualHR||''}">
      </div>
      <button class="wp-btn wp-btn-pri" style="width:100%;margin-top:16px" onclick="saveExerciseComplete()">✓ 保存并返回</button>
    </div>`;
  document.body.appendChild(ov);
}

function saveExerciseComplete() {
  const ex = _workoutState.exercise;
  const hrEl = document.getElementById('ex-complete-hr');
  if (hrEl) ex.actualHR = parseInt(hrEl.value) || null;
  saveWorkoutSession(_workoutState.session);
  const ov = document.getElementById('ex-complete-overlay');
  if (ov) ov.remove();
  flowBackToExerciseRecords(ex);
  document.getElementById('workout-player').style.display = 'none';
  _workoutState = null;
  const cp = localStorage.getItem('bc_ai_plan_cache');
  if (cp) renderPlan(cp);
  showToast('✅ 训练记录已保存');
}

// ===== 回流到 exercise 记录 =====
function flowBackToExerciseRecords(ex) {
  const db = getDB();
  const today = new Date().toISOString().slice(0,10);
  let dur = 0;
  if (ex.type === 'strength') {
    const sc = ex.sets.length;
    dur = Math.round((sc * 40 + Math.max(0, sc-1) * (ex.rest||90)) / 60 * 10) / 10;
  } else {
    dur = ex.actualDuration || 0;
  }
  let cal = 0;
  if (ex.actualHR && dur > 0 && ex.type === 'cardio') {
    const p = getProfile();
    const db2 = getDB();
    const lastBS = db2.bodyScale.length > 0 ? db2.bodyScale[db2.bodyScale.length-1] : null;
    const wt = lastBS ? lastBS.weight : 60;
    const isMale = p.gender === 'male';
    const factor = isMale ? 0.0006 : 0.0007;
    cal = Math.round(ex.actualHR * wt * factor * dur);
  }
  const rec = { date:today, time:'训练', name:ex.name, type:ex.type==='strength'?'力量':'有氧', dur:dur, cal:cal||0, hr:ex.actualHR||null };
  const ei = db.exercise.findIndex(r => r.date === today && r.name === ex.name && r.time === '训练');
  if (ei >= 0) db.exercise[ei] = rec; else db.exercise.push(rec);
  db.exercise.sort((a,b) => a.date.localeCompare(b.date));
  saveDB(db);
}

// ===== 关闭播放器 =====
function closeWorkoutPlayer() {
  if (_restTimer) { clearInterval(_restTimer); _restTimer = null; }
  if (_cardioTimer) { clearInterval(_cardioTimer); _cardioTimer = null; }
  if (_workoutState) {
    const ex = _workoutState.exercise;
    const hrEl = document.getElementById('wp-cardio-hr');
    if (hrEl) ex.actualHR = parseInt(hrEl.value) || null;
    saveWorkoutSession(_workoutState.session);
  }
  document.getElementById('workout-player').style.display = 'none';
  _workoutState = null;
  const cp = localStorage.getItem('bc_ai_plan_cache');
  if (cp) renderPlan(cp);
}

// Init is now handled by checkAuthAndInit() -> initApp() after auth check
// (see Supabase auth section below)
</script>

<!-- 训练播放器 -->
<div id="workout-player" class="wp-overlay">
  <div class="wp-header">
    <button class="wp-btn wp-btn-gh wp-btn-sm" onclick="closeWorkoutPlayer()">← 退出</button>
    <span id="wp-title" style="font-weight:700;font-size:15px">动作</span>
    <span id="wp-progress" style="font-size:12px;color:var(--muted)">0/0组</span>
  </div>
  <div class="wp-body" id="wp-content"></div>
  <div class="wp-bottom" id="wp-bottom"></div>
</div>

<!-- 个人资料弹窗 -->
<div id="profile-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1001;justify-content:center;align-items:center" onclick="if(event.target===this)closeProfile()">
  <div style="background:var(--card);border-radius:16px;width:90%;max-width:420px;max-height:85vh;overflow-y:auto;padding:20px;box-shadow:0 8px 32px rgba(0,0,0,0.3)">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <div style="font-size:16px;font-weight:700" id="profile-title">👤 个人资料</div>
      <button onclick="closeProfile()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--muted);padding:4px 8px">×</button>
    </div>
    <div class="fg"><label class="fl">昵称</label>
      <input type="text" id="pf-name" class="fi" placeholder="你的名字">
    </div>
    <div class="fg"><label class="fl">性别</label>
      <div style="display:flex;gap:8px;margin-top:4px">
        <label style="flex:1;text-align:center;padding:10px;border:1px solid var(--border);border-radius:8px;cursor:pointer" id="pf-male-lbl" onclick="selectGender('male')">
          <input type="radio" name="pf-gender" value="male" style="display:none"><span>👨 男性</span>
        </label>
        <label style="flex:1;text-align:center;padding:10px;border:1px solid var(--border);border-radius:8px;cursor:pointer" id="pf-female-lbl" onclick="selectGender('female')">
          <input type="radio" name="pf-gender" value="female" style="display:none"><span>👩 女性</span>
        </label>
      </div>
    </div>
    <div class="fg"><label class="fl">年龄</label>
      <input type="number" id="pf-age" class="fi" placeholder="如 35" min="10" max="100">
    </div>
    <div class="fg"><label class="fl">身高 (cm)</label>
      <input type="number" id="pf-height" class="fi" placeholder="如 175" min="100" max="250">
    </div>
    <div class="fg"><label class="fl">目标</label>
      <select id="pf-goal" class="fi">
        <option value="减重">🎯 减重</option>
        <option value="增肌">💪 增肌</option>
        <option value="减重+增肌">🔥 减重+增肌</option>
        <option value="维持">⚖️ 维持</option>
      </select>
    </div>
    <div class="fg" id="pf-cycle-row" style="display:none"><label class="fl">月经周期训练适配</label>
      <div style="display:flex;gap:8px;margin-top:4px">
        <label style="flex:1;text-align:center;padding:10px;border:1px solid var(--border);border-radius:8px;cursor:pointer" id="pf-cycle-on-lbl" onclick="selectCycle('true')">
          <input type="radio" name="pf-cycle" value="true" style="display:none"><span>✅ 启用</span>
        </label>
        <label style="flex:1;text-align:center;padding:10px;border:1px solid var(--border);border-radius:8px;cursor:pointer" id="pf-cycle-off-lbl" onclick="selectCycle('false')">
          <input type="radio" name="pf-cycle" value="false" style="display:none"><span>❌ 不用</span>
        </label>
      </div>
      <div style="font-size:11px;color:var(--dim);margin-top:6px;line-height:1.5">启用后，4周训练计划将按月经期→卵泡期→排卵期→黄体期生理节律排列</div>
    </div>
    <div style="display:flex;flex-direction:column;gap:8px;margin-top:16px">
      <button class="sub" onclick="saveProfile()" style="width:100%">💾 保存</button>
      <button onclick="closeProfile()" style="background:none;border:none;color:var(--dim);font-size:12px;cursor:pointer;padding:4px">跳过，稍后再设置</button>
    </div>
    <div style="font-size:10px;color:var(--dim);margin-top:10px;text-align:center">资料仅存储在本地浏览器中</div>
  </div>
</div>

<!-- 个人设置弹窗 -->
<div id="settings-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;justify-content:center;align-items:center" onclick="if(event.target===this)closeSettings()">
  <div style="background:var(--card);border-radius:16px;width:90%;max-width:420px;max-height:85vh;overflow-y:auto;padding:20px;box-shadow:0 8px 32px rgba(0,0,0,0.3)">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
      <div style="font-size:16px;font-weight:700">⚙️ API 设置</div>
      <button onclick="closeSettings()" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--muted);padding:4px 8px">×</button>
    </div>

    <div style="border-bottom:1px solid var(--border);padding-bottom:16px;margin-bottom:16px">
      <div style="font-size:14px;font-weight:600;margin-bottom:10px">🤖 AI 运动计划</div>
      <div class="fg"><label class="fl">DeepSeek API Key</label>
        <input type="password" id="ai-key" class="fi" placeholder="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx">
      </div>
      <div style="font-size:11px;color:var(--dim);margin-top:6px;line-height:1.5">
        用于生成运动计划。获取 Key：<a href="https://platform.deepseek.com/api_keys" target="_blank" style="color:var(--accent)">platform.deepseek.com</a>
      </div>
    </div>

    <div>
      <div style="font-size:14px;font-weight:600;margin-bottom:10px">📸 截图识别视觉模型</div>
      <div class="fg"><label class="fl">Vision API Key</label>
        <input type="password" id="ai-vision-key" class="fi" placeholder="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx">
      </div>
      <div class="fg"><label class="fl">Vision API 地址（CORS 代理）</label>
        <input type="text" id="ai-vision-url" class="fi" placeholder="https://1469564893-2azg8ebcd5.ap-guangzhou.tencentscf.com" style="font-size:12px" value="https://1469564893-2azg8ebcd5.ap-guangzhou.tencentscf.com">
      </div>
      <div class="fg"><label class="fl">Vision 模型名</label>
        <input type="text" id="ai-vision-model" class="fi" placeholder="sensenova-6.8-flash-lite" style="font-size:12px" value="sensenova-6.8-flash-lite">
      </div>
      <div style="font-size:11px;color:var(--dim);margin-top:6px;line-height:1.5">
        用于截图识别体脂秤/训练/睡眠数据。地址默认走 CORS 代理（浏览器无法直连官方 API），请勿改回官方地址。商汤 SenseNova 平台：<a href="https://platform.sensenova.cn" target="_blank" style="color:var(--accent)">platform.sensenova.cn</a>
      </div>
    </div>

    <button class="sub" onclick="saveAIKey()" style="margin-top:16px;width:100%">💾 保存设置</button>
    <button onclick="handleLogout()" style="margin-top:10px;width:100%;padding:10px;font-size:13px;background:var(--card);border:1px solid var(--border);color:var(--red);border-radius:8px;cursor:pointer">🚪 退出登录</button>
    <div style="font-size:10px;color:var(--dim);margin-top:10px;text-align:center;line-height:1.5">
      所有 Key 仅存储在本地浏览器 localStorage 中，不会上传到任何服务器。
    </div>
  </div>
</div>

<script>
function openProfile() {
  const ov = document.getElementById('profile-overlay');
  ov.style.display = 'flex';
  const p = getProfile();
  document.getElementById('pf-name').value = p.name || '';
  document.getElementById('pf-age').value = p.age || '';
  document.getElementById('pf-height').value = p.height || '';
  document.getElementById('pf-goal').value = p.goal || '减重+增肌';
  // gender radio styling
  const gm = document.querySelector('input[name=pf-gender][value=male]');
  const gf = document.querySelector('input[name=pf-gender][value=female]');
  gm.checked = p.gender === 'male';
  gf.checked = p.gender === 'female';
  updateGenderLabels();
  // cycle radio
  const co = document.querySelector('input[name=pf-cycle][value=false]');
  const cn = document.querySelector('input[name=pf-cycle][value=true]');
  if (co) co.checked = p.useCycle !== true;
  if (cn) cn.checked = p.useCycle === true;
  updateCycleLabels();
  // show/hide cycle row based on gender
  toggleCycleRow();
}
function closeProfile() {
  document.getElementById('profile-overlay').style.display = 'none';
}
function getProfile() {
  try { return JSON.parse(localStorage.getItem('bc_profile') || '{}'); } catch(e) { return {}; }
}
function updateGenderLabels() {
  const gm = document.querySelector('input[name=pf-gender][value=male]');
  const gf = document.querySelector('input[name=pf-gender][value=female]');
  const ml = document.getElementById('pf-male-lbl');
  const fl = document.getElementById('pf-female-lbl');
  if (ml) { ml.style.borderColor = gm.checked ? 'var(--accent)' : 'var(--border)'; ml.style.background = gm.checked ? 'var(--bg)' : 'var(--card)'; }
  if (fl) { fl.style.borderColor = gf.checked ? 'var(--accent)' : 'var(--border)'; fl.style.background = gf.checked ? 'var(--bg)' : 'var(--card)'; }
}
function updateCycleLabels() {
  const cn = document.querySelector('input[name=pf-cycle][value=true]');
  const co = document.querySelector('input[name=pf-cycle][value=false]');
  const nl = document.getElementById('pf-cycle-on-lbl');
  const fl = document.getElementById('pf-cycle-off-lbl');
  if (nl) { nl.style.borderColor = cn && cn.checked ? 'var(--accent)' : 'var(--border)'; nl.style.background = cn && cn.checked ? 'var(--bg)' : 'var(--card)'; }
  if (fl) { fl.style.borderColor = co && co.checked ? 'var(--accent)' : 'var(--border)'; fl.style.background = co && co.checked ? 'var(--bg)' : 'var(--card)'; }
}
function toggleCycleRow() {
  const gf = document.querySelector('input[name=pf-gender][value=female]');
  const row = document.getElementById('pf-cycle-row');
  if (row) row.style.display = gf.checked ? 'block' : 'none';
}
function saveProfile() {
  const p = {
    name: document.getElementById('pf-name').value.trim() || '用户',
    gender: document.querySelector('input[name=pf-gender]:checked') ? document.querySelector('input[name=pf-gender]:checked').value : '',
    age: parseInt(document.getElementById('pf-age').value) || null,
    height: parseFloat(document.getElementById('pf-height').value) || null,
    goal: document.getElementById('pf-goal').value,
    useCycle: document.querySelector('input[name=pf-cycle]:checked') ? document.querySelector('input[name=pf-cycle]:checked').value === 'true' : false
  };
  localStorage.setItem('bc_profile', JSON.stringify(p));
  scheduleCloudSync();
  applyProfile(p);
  closeProfile();
  showToast('资料已保存');
}
function applyProfile(p) {
  if (!p) p = getProfile();
  // Update header
  const av = document.getElementById('hdr-av');
  const nm = document.getElementById('hdr-name');
  const gl = document.getElementById('hdr-goal');
  if (av) av.textContent = (p.name || 'C').charAt(0).toUpperCase();
  if (nm) nm.textContent = p.name || '未设置';
  if (gl) gl.textContent = p.goal ? '🎯 ' + p.goal : '🎯 点击设置';
  // Show/hide menstrual cycle selector on AI page
  const cycleRow = document.getElementById('ai-cycle-row');
  if (cycleRow) {
    const show = (p.gender === 'female' && p.useCycle === true);
    cycleRow.style.display = show ? 'block' : 'none';
    if (!show) {
      const sel = document.getElementById('ai-cycle');
      if (sel) sel.value = '';
    }
  }
}
function openSettings() {
  const ov = document.getElementById('settings-overlay');
  ov.style.display = 'flex';
  // 回填值
  document.getElementById('ai-key').value = localStorage.getItem('bc_agent_deepseek_key') || '';
  document.getElementById('ai-vision-key').value = localStorage.getItem('ai_vision_key') || '';
  document.getElementById('ai-vision-url').value = localStorage.getItem('ai_vision_url') || 'https://1469564893-2azg8ebcd5.ap-guangzhou.tencentscf.com';
  document.getElementById('ai-vision-model').value = localStorage.getItem('ai_vision_model') || 'sensenova-6.8-flash-lite';
}
function closeSettings() {
  document.getElementById('settings-overlay').style.display = 'none';
}

// ===== Supabase 认证 + 云同步 =====
const SUPABASE_URL = 'https://cseydwhdrzeondtcvyxa.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNzZXlkd2hkcnplb25kdGN2eXhhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY4ODUyMDcsImV4cCI6MjEwMjQ2MTIwN30.fBqOMzdQSqi8s12loRS2WZKEUs7cqMqQ8ZJlz-IWax4';
let supabaseClient = null;
let currentUser = null;
let cloudSyncTimer = null;

// 哪些 key 同步到云端（API keys 不同步）
const SYNC_KEYS = {
  'bc_agent_records_v9': null,      // 主数据库，需拆分到 body_scale/exercise/sleep
  'bc_workout_sessions': 'workout_sessions',
  'bc_profile': 'profile',
  'bc_ai_plan_cache': 'ai_plan_cache',
  'bc_ai_plan_cache_time': 'ai_plan_cache_time',
  'bc_ai_state': 'ai_state'
};

function initSupabase() {
  if (window.supabase) {
    supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    return true;
  }
  return false;
}

// 从云端加载数据到 localStorage
async function loadFromCloud(userId) {
  if (!supabaseClient) return;
  try {
    const { data, error } = await supabaseClient
      .from('user_data')
      .select('*')
      .eq('user_id', userId)
      .single();

    if (error && error.code !== 'PGRST116') throw error; // PGRST116 = no rows found

    if (data) {
      // 重建主数据库
      const db = { bodyScale: data.body_scale || [], exercise: data.exercise || [], sleep: data.sleep || [] };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(db));

      if (data.workout_sessions) localStorage.setItem('bc_workout_sessions', JSON.stringify(data.workout_sessions));
      if (data.profile) localStorage.setItem('bc_profile', JSON.stringify(data.profile));
      if (data.ai_plan_cache) localStorage.setItem('bc_ai_plan_cache', data.ai_plan_cache);
      if (data.ai_plan_cache_time) localStorage.setItem('bc_ai_plan_cache_time', data.ai_plan_cache_time);
      if (data.ai_state) localStorage.setItem('bc_ai_state', JSON.stringify(data.ai_state));
      return true; // 有数据
    }
    return false; // 无数据
  } catch (e) {
    console.error('Cloud load error:', e);
    return false;
  }
}

// 从 localStorage 同步数据到云端（debounced）
function scheduleCloudSync() {
  if (!currentUser || !supabaseClient) return;
  if (cloudSyncTimer) clearTimeout(cloudSyncTimer);
  cloudSyncTimer = setTimeout(doCloudSync, 2000);
}

async function doCloudSync() {
  if (!currentUser || !supabaseClient) return;
  try {
    const db = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    const workoutSessions = JSON.parse(localStorage.getItem('bc_workout_sessions') || '[]');
    const profile = JSON.parse(localStorage.getItem('bc_profile') || '{}');
    const aiPlanCache = localStorage.getItem('bc_ai_plan_cache') || null;
    const aiPlanCacheTime = localStorage.getItem('bc_ai_plan_cache_time') || null;
    const aiState = JSON.parse(localStorage.getItem('bc_ai_state') || '{}');

    const { error } = await supabaseClient
      .from('user_data')
      .upsert({
        user_id: currentUser.id,
        body_scale: db.bodyScale || [],
        exercise: db.exercise || [],
        sleep: db.sleep || [],
        workout_sessions: workoutSessions,
        profile: profile,
        ai_plan_cache: aiPlanCache,
        ai_plan_cache_time: aiPlanCacheTime,
        ai_state: aiState,
        updated_at: new Date().toISOString()
      });

    if (error) console.error('Cloud sync error:', error);
  } catch (e) {
    console.error('Cloud sync error:', e);
  }
}

// 处理登录/注册
async function handleAuth(mode) {
  const email = document.getElementById('auth-email').value.trim();
  const pass = document.getElementById('auth-pass').value;
  const errEl = document.getElementById('auth-error');
  const formDiv = document.getElementById('auth-form');
  const loadingDiv = document.getElementById('auth-loading');

  if (!email || !pass) {
    errEl.textContent = '请输入邮箱和密码';
    errEl.style.display = 'block';
    return;
  }
  if (pass.length < 6) {
    errEl.textContent = '密码至少6位';
    errEl.style.display = 'block';
    return;
  }

  errEl.style.display = 'none';
  formDiv.style.display = 'none';
  loadingDiv.style.display = 'block';

  try {
    let result;
    if (mode === 'signup') {
      result = await supabaseClient.auth.signUp({ email, password: pass });
      if (result.data.user && !result.data.session) {
        // 需要邮箱确认
        errEl.textContent = '注册成功！请检查邮箱确认链接';
        errEl.style.color = 'var(--green)';
        errEl.style.display = 'block';
        formDiv.style.display = 'block';
        loadingDiv.style.display = 'none';
        return;
      }
    } else {
      result = await supabaseClient.auth.signInWithPassword({ email, password: pass });
    }

    if (result.error) throw result.error;
    if (result.data.user) {
      currentUser = result.data.user;
      await afterLogin();
    }
  } catch (e) {
    errEl.textContent = e.message || '操作失败';
    errEl.style.display = 'block';
    formDiv.style.display = 'block';
    loadingDiv.style.display = 'none';
  }
}

// 登录后初始化
async function afterLogin() {
  const hasCloudData = await loadFromCloud(currentUser.id);
  if (!hasCloudData) {
    // 云端无数据，上传本地数据（保留 Cris 已有数据）
    await doCloudSync();
  }
  // 隐藏登录遮罩
  document.getElementById('auth-overlay').style.display = 'none';
  // 初始化应用
  initApp();
}

// 退出登录
async function handleLogout() {
  if (!confirm('确定退出登录？本地数据将被清除。')) return;
  try { if (supabaseClient) await supabaseClient.auth.signOut(); } catch(e) { console.error('signOut error:', e); }
  // 清除个人数据（保留 API keys）
  ['bc_agent_records_v9', 'bc_workout_sessions', 'bc_profile', 'bc_ai_plan_cache', 'bc_ai_plan_cache_time', 'bc_ai_state'].forEach(k => localStorage.removeItem(k));
  currentUser = null;
  location.reload();
}

// 初始化应用（从 DOMContentLoaded 提取）
function initApp() {
  try { updateExSelector(); } catch(e) { console.error('updateExSelector:', e); }
  try { toggleExForm(); } catch(e) { console.error('toggleExForm:', e); }
  try { renderOverview(); } catch(e) { console.error('renderOverview:', e); }
  try { renderReport(); } catch(e) { console.error('renderReport:', e); }
  try { document.getElementById('rd').value = new Date().toISOString().slice(0,10); } catch(e) {}
  try { applyProfile(); } catch(e) { console.error('applyProfile:', e); }
  // 性别/月经周期：label onclick 已直接调用 selectGender/selectCycle
  // 这里仍保留 change 监听器作为桌面端冗余保障
  document.querySelectorAll('input[name=pf-gender]').forEach(r => {
    r.addEventListener('change', () => { updateGenderLabels(); toggleCycleRow(); });
  });
  document.querySelectorAll('input[name=pf-cycle]').forEach(r => {
    r.addEventListener('change', updateCycleLabels);
  });
  const p = getProfile();
  if (!p.name && !p.gender) {
    setTimeout(() => { try { openProfile(); } catch(e){} }, 500);
  }
}

// 页面加载时检查认证状态
function skipAuth() {
  document.getElementById('auth-overlay').style.display = 'none';
  initApp();
}

async function checkAuthAndInit() {
  // 超时兜底：5秒后无论Supabase是否加载完成，都强制启动app
  let timedOut = false;
  const fallbackTimer = setTimeout(() => {
    if (timedOut) return;
    timedOut = true;
    console.warn('Supabase timeout, falling back to local mode');
    document.getElementById('auth-overlay').style.display = 'none';
    initApp();
  }, 5000);

  try {
    if (!initSupabase()) {
      console.warn('Supabase SDK not loaded, using local mode');
      clearTimeout(fallbackTimer);
      document.getElementById('auth-overlay').style.display = 'none';
      initApp();
      return;
    }

    const { data: { session }, error } = await supabaseClient.auth.getSession();
    if (timedOut) return; // 超时已启动，不重复执行
    clearTimeout(fallbackTimer);

    if (error) throw error;

    if (session && session.user) {
      currentUser = session.user;
      try {
        const hasCloudData = await loadFromCloud(currentUser.id);
        if (!hasCloudData) {
          await doCloudSync();
        }
      } catch(e) {
        console.error('Cloud sync error (non-fatal):', e);
      }
      document.getElementById('auth-overlay').style.display = 'none';
      initApp();
    }
    // 否则保持登录遮罩显示
  } catch(e) {
    console.error('Auth init error, falling back to local mode:', e);
    clearTimeout(fallbackTimer);
    if (!timedOut) {
      document.getElementById('auth-overlay').style.display = 'none';
      initApp();
    }
  }
}

// 启动
checkAuthAndInit();

</script>

</body>
</html>
